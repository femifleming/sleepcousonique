/* scq_proc_spectral: P(...) table lines */
P("convolve", FAM_SPACE, 0, 1050, 1, "in capture mix", "0 0 0.5", "out", run_convolve, 0, mem_convolve,
  "the room becomes the effect: a pulse into capture listens for the next loud sound (a clap in a stairwell, under a bridge) and convolves in with what the room gave back, nature x 0.1 s of it (2.5 is all the house holds), as loud as what comes in; until then a made-up room (partitioned FFT convolution, 21 ms late; for the Wingie)"),
P("morph",   FAM_SHAPE, 0, 1400, 2, "a b blend smooth", "0 0 1 0", "out", run_morph, 0, mem_morph,
  "cross-synthesis: the magnitudes of a on the phases of b, blend how far; smooth makes it a's spectral envelope on b's fine structure, a vocoder with no bands (FFT 512/1024/2048 by nature, 27 ms late at 2; for the Wingie)"),
P("specshift", FAM_SHAPE, 0, 1500, 2, "in shift stretch", "0 0 0", "out", run_specshift, 0, mem_specshift,
  "spectral pitch shift in octaves, peaks moved with their shapes and phases locked (Laroche-Dolson); stretch pulls the partials apart like a stiff string, or squeezes them (FFT by nature, 27 ms late at 2; for the Wingie)"),
P("specgate", FAM_SHAPE, 0, 900, 2, "in threshold", "0 0.3", "out", run_specgate, 0, mem_specgate,
  "spectral gate: every bin below threshold (-90 to 0 dB) falls away, the hiss under the highway goes and the tones stay; keep=quiet keeps only the hiss (FFT by nature, 27 ms late at 2; for the Wingie)"),
P("spectraldelay", FAM_SPACE, 0, 520, 2, "in time spread feedback", "0 0.5 0.5 0.4", "out", run_spectraldelay, 0, mem_spectraldelay,
  "every bin its own delay and feedback: time up to nature x 0.1 s, spread fans them across the spectrum by curve=rising|falling|random; echoes that arpeggiate the spectrum (FFT 1024, 32 ms late; for the Wingie)"),
P("specfilter", FAM_SHAPE, 0, 1000, 2, "in shape_amount pitch", "0 0.5 0", "out", run_specfilter, 0, mem_specfilter,
  "a filter drawn on the spectrum, shape=comb|teeth|tilt|formants|harmonics: shape_amount digs it in (for formants it walks a e i o u, for tilt -6 to +6 dB an octave), pitch moves it from 110 Hz (FFT by nature, 27 ms late at 2; for the Wingie)"),
P("resynth", FAM_SHAPE, 0, 850, 3, "in partials pitch freeze", "0 0.5 0 0", "out", run_resynth, 0, mem_resynth,
  "the tonal skeleton: the loudest peaks of each frame (partials 1 to 40) followed and sung again as clean sines, pitch moves them all, freeze holds them while high (after McAulay-Quatieri, SPEAR; FFT 2048 at nature 3, 32 ms late; for the Wingie)"),
P("formantshift", FAM_SHAPE, 0, 1800, 2, "in shift", "0 0", "out", run_formantshift, 0, mem_formantshift,
  "moves the formants (the cepstral envelope) by shift octaves and leaves the pitch where it is: a throat that grows or shrinks (FFT by nature, 27 ms late at 2; for the Wingie)"),
P("binaural", FAM_SPACE, 0, 170, 1, "in azimuth elevation distance", "0 0 0 0.25", "left right", run_binaural, 0, mem_binaural,
  "puts a sound around your head on headphones: azimuth 0 ahead, 0.25 right, 0.5 behind; elevation -1 to 1; distance 0.25 to 10 m, moving smoothly (Brown-Duda head: interaural delay, head shadow, pinna notch)"),
P("ambi",    FAM_SPACE, 0, 100, 1, "in azimuth elevation width", "0 0 0 0.5", "left right", run_ambi, 0, mem_ambi,
  "first-order ambisonics on two speakers: the sound placed at azimuth (0 ahead, 0.25 right) and elevation, decoded as UHJ stereo; width 0 mono, 0.5 UHJ, 1 super-stereo (after Gerzon)"),
P("crossfeed", FAM_SPACE, 0, 66, 1, "in1 in2 amount", "0 0 0.6", "left right", run_crossfeed, 0, 0,
  "headphone crossfeed, in1 left and in2 right: each ear hears the other side low and late, as from speakers; amount 0 is off (after Bauer, bs2b)"),
P("bassman", FAM_SHAPE, 0, 170, 2, "in sub drive", "0 0.5 0.2", "out sub", run_bassman, 0, mem_bassman,
  "the sound system's low end: split at nature x 60 Hz, a pure sine an octave below (octave=two: two) locked to the bass, drive into a clean limiter; out is everything, sub the low end alone"),
P("harmonizer", FAM_SHAPE, 0, 2400, 2, "in pitch mix", "0 0 0.5", "left right", run_harmonizer, 0, mem_harmonizer,
  "three voices above (or below) in, from chord=major|minor|fifths|octaves|sus|seventh|otonal|utonal, detune= cents of slow chorus, spread left, right and centre; pitch moves the chord (phase vocoder, 27 ms late; for the Wingie)"),
P("deverb",  FAM_SPACE, 0, 950, 2, "in amount", "0 0.5", "out", run_deverb, 0, mem_deverb,
  "takes the room out: the slow part of each bin is subtracted, so tails and steady tones sink and attacks stand; negative amount pours the room back in (FFT by nature, 27 ms late at 2; for the Wingie)"),
