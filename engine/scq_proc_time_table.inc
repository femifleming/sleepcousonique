/* scq_proc_time: time — delays, loops, grains, spectra, reverbs and space (scq_proc_time.inc) */
P("beauty",   FAM_SPACE, 0, 650, 1, "in time spread feedback jitter", "0 0.5 1 0.3 0.3", "left right", run_beauty, init_beauty, mem_beauty,
  "multitap delay: eight taps across a span (20 ms to 0.8 s, longer at lower samplerates), each drifting in level, pan and brightness of its own; spread fans the taps out (0 all together), jitter makes their times wander (after ppooll's Beauty)"),
P("pt2399",   FAM_SPACE, 0, 350, 1, "in time feedback", "0 0.4 0.4", "out", run_pt2399, 0, mem_pt2399,
  "the PT2399 echo chip: 30 to 340 ms, companded, darker and grittier as the time grows, the clock's whine; turning time bends the pitch, feedback past 0.8 screams (after the Chloe's delay and every PT2399 pedal)"),
P("dub",      FAM_SPACE, 0, 400, 1, "in throw time feedback tone", "0 0 0.4 0.6 0.4", "out wet", run_dub, 0, mem_dub,
  "dub echo send: only while throw is up does in go into the echo (up to 0.8 s); a spring splash, saturation and a tone that cuts lows and highs live inside the loop, so feedback past 0.8 runs away and can be pulled back; out is in plus the echo (after King Tubby, Lee Perry, the Space Echo)"),
P("reverse",  FAM_SPACE, 0, 280, 1, "in size mix", "0 0.4 1", "out", run_reverse, 0, mem_reverse,
  "reverse delay: slices of 30 ms to 0.4 s (longer at lower samplerates) played backwards, two heads crossfading; mix from dry to all reversed; feedback= sends it round again"),
P("stutter",  FAM_SPACE, 0, 100, 1, "in trig length decay", "0 0 0.3 0.7", "out", run_stutter, init_stutter, mem_stutter,
  "beat repeat: a pulse into trig repeats the last slice (10 to 400 ms) in place of the sound, each repeat quieter by decay (trig held high: no fading); shrink= shortens each repeat (0-0.9), drop= bends each one in semitones (after Ableton's Beat Repeat)"),
P("looper",   FAM_SPACE, 0, 120, 1, "in record overdub speed erase", "0 0 0 1 0", "out position end", run_looper, 0, mem_looper,
  "loop pedal: hold record to catch a loop (as long as you hold it, up to 0.42 s at full rate, 0.83 s at half, 3.3 s at eighth), overdub to layer, speed 1 is as played, negative backwards; erase starts again; position 0 to 1, end pulses each turn (after the Echoplex Digital Pro)"),
P("tapeloop", FAM_SPACE, 0, 200, 1, "in punch speed age", "0 0 0 0.3", "left right", run_tapeloop, 0, mem_tapeloop,
  "a six-second tape loop for the voice: punch records over it (some of the old stays), age wears it (duller and quieter each pass, hiss, wow and flutter), speed in octaves; left is the head just after the record head, right a second head further round; seconds= (0.5-12) and gap= (where the right head sits, 0-1) (after Frippertronics, Basinski)"),
P("eis",      FAM_SPACE, 0, 280, 1, "in rate depth feedback", "0 0.3 0.4 0.5", "left right", run_eis, 0, mem_eis,
  "four delays of a quarter to half a second whose times wander slowly, feeding each other through a matrix and turning around the stereo field; rate how fast, depth how far (after Pauline Oliveros' Expanded Instrument System)"),
P("shimmer",  FAM_SPACE, 0, 650, 1, "in size shimmer", "0 0.6 0.5", "left right", run_shimmer, 0, mem_shimmer,
  "shimmer reverb: the tail goes round through an octave-up pitch shifter, so it climbs; size 1.5 to 30 s, shimmer how much climbs; interval= in semitones. Heavy: samplerate=half on the SP-1 (after Eno and Lanois, Valhalla Shimmer)"),
P("cloud",    FAM_SPACE, 0, 600, 1, "in freeze density size pitch spread", "0 0 0.5 0.4 0 0.5", "left right", run_cloud, 0, mem_cloud,
  "texture cloud: up to 24 clean grains of the live sound (Hann windows, Hermite reads, 0.4 s buffer at full rate); freeze holds it, density how many overlap, size 12 ms to 0.5 s, pitch in octaves, spread scatters them in time, place and stereo. Heavy at full density: at home on the Wingie (after Curtis Roads, Barry Truax)"),
P("concat",   FAM_SPACE, 0, 160, 1, "in record bright loud follow trig", "0 0 0.5 0.7 0 0", "out", run_concat, init_concat, mem_concat,
  "concatenative sampler: record cuts the input into 25 ms slices (the last 16 kept, each known by loudness and brightness); the slice nearest bright and loud plays, crossfading into the next; follow aims at the live input's own features and loudness instead; trig picks now (after Coalescence, CataRT)"),
P("smear",    FAM_SPACE, 0, 900, 1, "in blur", "0 0.5", "out", run_smear, init_spectral, mem_spectral,
  "spectral blur: a 512-point phase vocoder holds each partial's level and frequency for longer, blur from none to seconds, a little across frequency too. Heavy: at home on the Wingie, or samplerate=half on the SP-1"),
P("specfreeze", FAM_SPACE, 0, 750, 1, "in freeze blend", "0 0 0", "out", run_specfreeze, init_spectral, mem_spectral,
  "spectral freeze: while freeze is up the spectrum is held and sung on with drifting phases; blend lets the live sound seep into what is held; down, the sound passes. Heavy: at home on the Wingie, or samplerate=half on the SP-1 (after ppooll's spectral freeze and the Disting EX's)"),
P("cavern",   FAM_SPACE, 0, 900, 1, "in size dark hold", "0 0.5 0.5 0", "left right", run_cavern, 0, mem_cavern,
  "a long dark reverb for drones: eight slowly moving lines through a Hadamard matrix, size 3 s to a minute, dark how fast the highs go; hold rings for ever and lets nothing new in. Heavy: samplerate=half on the SP-1 (after Jot's feedback delay networks)"),
P("doppler",  FAM_SPACE, 0, 160, 1, "in position distance speed", "0 0 0.2 0.3", "left right", run_doppler, 0, mem_doppler,
  "a source moving past on a line: position -1 to 1 (60 m each way), distance of the line 1 to 40 m, speed sends it by again and again (up to 60 m/s); pitch falls as it passes, it fades and dulls with distance, the far ear hears it later (after Chowning, Xenakis, Leitner)"),
P("haas",     FAM_SPACE, 0, 140, 1, "in width", "0 0.5", "left right", run_haas, 0, mem_haas,
  "stereo widener: lows stay in the middle, highs open into two complementary combs and a small lead to the left; mono-compatible (after Haas, Gerzon)"),
P("swarm",    FAM_SPACE, 0, 350, 1, "in density chaos pitch", "0 0.5 0.5 0", "left right", run_swarm, init_swarm, mem_swarm,
  "a swarm of insects: up to twenty tiny clean grains of the live sound, scattered in time, pitch and stereo by a logistic map; low chaos keeps a pattern, high chaos sets them loose; pitch in octaves (after Xenakis, Di Scipio)"),
