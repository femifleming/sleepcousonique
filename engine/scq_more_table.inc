/* The new places, in the same form as the first ones. Included inside SCQ_PLACES. */

/* ---- sources ---- */
P("turntable", FAM_SOURCE, PF_DRIFT, 247, 4, "pitch fm width sync", "0 0 0 0", "saw square tri sine", run_turntable, 0, 0,
