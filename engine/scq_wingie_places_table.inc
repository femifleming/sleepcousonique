/* scq_wingie_places: the Wingie collection's table lines (code in scq_wingie_places.inc) */
P("wingie",  FAM_SPACE, PF_DRIFT, 290, 2, "in pitch decay strike", "0 0 0.5 0", "out odd even", run_wingie, 0, mem_wg_bank,
  "the Wingie2's resonator: nine modes at nature x 60 Hz ringing on what comes in, its own maths, anti-feedback guard and input / output stage; decay 0..1 is 0.1 to 10 s, strike rings every mode, odd and even split the modes; shape=string|bar|membrane|cave|ratio (ratio=1.5 stacks each mode that much above the last) (after Meng Qi's Wingie2)"),
P("cave",    FAM_SPACE, 0, 270, 1, "in decay shift strike", "0 0.5 0 0", "out odd even", run_cave, 0, mem_wg_bank,
  "the Wingie2's three factory caves as a resonator: nature 1 Low, 2 Mid, 3 High; shift moves them in octaves (after Meng Qi's Wingie2)"),
P("coco",    FAM_SPACE, 0, 70, 1, "in rate feedback freeze skip flip pan", "0 1 0.5 0 0 0 0.5", "out verso inverso", run_coco, init_coco, mem_coco,
  "8-bit delay whose clock is the time: nature seconds long at full rate, slower is longer and lower; freeze holds the loop, skip jumps the head, flip turns it round; verso and inverso are out panned by pan and against it (after Peter Blasser's Coco)"),
P("cocoquantus", FAM_SPACE, 0, 150, 0.5, "in right rate feedback freeze petals skip flip", "0 0 1 0.5 0 0.3 0 0", "left right petal", run_cocoquantus, init_cocoquantus, mem_cocoquantus,
  "two Cocos (nature seconds each; in feeds both unless right is patched) and a five-petal Quantussy inside that wobbles their clocks and swings their verso / inverso across; petals is its speed; auto=off|skip|flip|both lets the petals skip and flip (after Peter Blasser's Cocoquantus)"),
P("petals",  FAM_CURRENT, PF_DRIFT, 150, 1, "rate couple", "0 0.5", "a b c d", run_petals, init_petals, 0,
  "five triangle cores in a ring, each hurried or held back by its neighbours' signs: lurching, never quite periodic; rate climbs 12 octaves into a drone; form=tri|square|pulse (after Peter Blasser's Quantussy)"),
P("relabi",  FAM_CURRENT, PF_DRIFT, 120, 1, "rate smear", "0.5 0", "pulse sum strength", run_relabi, init_relabi, 0,
  "almost a beat: four sines at irrational ratios summed, a pulse at each upward zero crossing, strength how steep it was; smear lets each sine wander (after John Berndt's relabi)"),
P("dust",    FAM_SOURCE, 0, 60, 4, "density", "0.5", "out pulse", run_dust, 0, 0,
  "random impulses of random height, nature a second at density 0.5 (1/64 to 64 times that) (after SuperCollider's Dust)"),
P("haze",    FAM_CURRENT, 0, 40, 2, "trig lo hi glide", "0 0 1 0.3", "out", run_haze, 0, 0,
  "on each trigger it glides to a new random value between lo and hi (glide 0..1 is 0 to 2 s); untriggered it moves on its own every nature seconds or so"),
P("listen",  FAM_SPACE, 0, 370, 1, "in listen decay strike", "0 0 0.5 0", "out locked", run_listen, 0, mem_listen,
  "tuned to the ground: while listen is held it listens to what comes in; when it lets go it tunes its nine Wingie resonators to the nine strongest resonances it heard, and locked pulses; until then it rings the Low cave times nature (after the Wingie's Tuned to the Ground)"),
P("sittingroom", FAM_SPACE, 0, 210, 1, "in generations", "0 0.3", "out room", run_sittingroom, init_sittingroom, mem_sittingroom,
  "what comes in played into a room and recorded again, generation after generation (generations 0..1 is 0 to 32 passes) until only the room's resonances are left; nature is the room's size (1: 5.2 x 4.1 x 2.7 m), the name picks its modes (after Alvin Lucier, I Am Sitting in a Room)"),
P("talkingdrum", FAM_SPACE, PF_DRIFT, 300, 2, "in squeeze pitch strike depth decay", "0 0 0 0 0.5 0.3", "out", run_talkingdrum, 0, mem_wg_bank,
  "a membrane resonator at nature x 60 Hz whose pitch is squeezed up to depth octaves: mode=rise climbs with how loud in is, mode=fall starts each stroke high and falls; squeeze squeezes it by hand (after the talking drum)"),
P("metastaseis", FAM_SPACE, 0, 320, 8, "in go pitch stagger density decay", "0 0 0 0.3 0.3 0.6", "out l r pos", run_metastaseis, 0, mem_wg_bank,
  "nine single resonances gliding in straight lines of pitch from chord A to chord B in nature seconds; go turns them round, stagger starts each a little after the one below, density strikes them with dust; chorda= chordb= unison|cluster|fifths|minor|major|diminished|wholetone|harmonic|pentatonic|fourths, cycle=off|on (after Iannis Xenakis, Metastaseis)"),
P("fourbit", FAM_CURRENT, 0, 60, 1, "in capture clock reset", "0 0 0 0", "violin piano cello all", run_fourbit, init_fourbit, mem_fourbit,
  "a capture pulse takes 64 bits from the sign of in; three loops of 64, 68 and 72 steps play them against each other, a pulse for every 1 (16ths at 120 BPM x nature until a clock is patched); movement=one|two|three (after Four Bit Modulo Phase Triplex for Violin, Piano and Cello)"),
P("knot",    FAM_SOURCE, PF_DRIFT, 170, 2, "clock pitch rate lock cross shape decay", "0 0 0.5 0.5 0.3 0.3 0.4", "left right a b", run_knot, init_knot, 0,
  "two voices, each a triangle-to-square oscillator stepped by an 8-bit XOR shift register (lock holds the loop), with an envelope and a VCA; cross lets the voices clock each other; a and b pulse on each voice's notes (after the Lorre Mill Double Knot)"),
P("benjolin", FAM_SOURCE, PF_DRIFT, 190, 2, "pitch ratio chaos cutoff res loop", "0 0.3 0.5 0.5 0.5 0", "out tri pulse rungler", run_benjolin, init_benjolin, 0,
  "two oscillators, a rungler shift register between them, a twin-peak filter on their comparison; chaos is how much the rungler bends everything, loop locks the pattern (after Rob Hordijk's Benjolin)"),
P("rollz",   FAM_CURRENT, 0, 70, 2, "speed spread drama", "0.5 0.4 0.5", "a b c d", run_rollz, init_rollz, 0,
  "a ring of five pulse oscillators, nature times a second; each fire pulls its neighbours forward and pushes the far ones back (drama), so the rhythm rolls and lurches instead of keeping a grid; four lanes out (after Peter Blasser's Rollz-5)"),
P("probee",  FAM_CURRENT, 0, 30, 1, "trig width", "0 1", "a b c d", run_probee, init_probee, 0,
  "on every trigger four new random values, held; width narrows them around 0.5; spread=uniform|gauss|bimodal (after the Probee Max for Live device)"),
