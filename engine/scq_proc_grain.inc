/* ------------------------------------------------------------------ the grain engine
 *
 * One small engine under every place here (after Curtis Roads' Microsound, Barry Truax, the GRM
 * tools, Quanta, Borderlands, Granulator II): no lo-fi on purpose.
 *  - the tape: 16 bits in the pool, written with a TPDF dither of one step (no truncation
 *    distortion at low levels), DC-blocked on the way in so no grain carries a thump;
 *  - every read is a 4-point Hermite on a split position (whole sample + fraction), so a grain
 *    at its own pitch reads the very samples that were written;
 *  - a grain that is pitched up is read twice a sample (at t and t + 1/2) and the two-times
 *    stream goes through a 63-tap half-band lowpass (flat to 18 kHz, -80 dB from 28 kHz): an
 *    octave up does not alias, two octaves up only what sits above 12 kHz. Grains at or below
 *    their pitch are read once and delayed to match, so the two kinds line up to the sample;
 *  - windows from tables (hann, gauss, tukey, blackman-harris, expodec, rexpodec);
 *  - onsets to the sub-sample (a grain due between two samples starts that far into its window);
 *  - the sum is normalised every sample from the windows that are sounding: their amplitude sum
 *    for grains that read the same moment (coherent: a sine stays a sine), their power sum for
 *    grains that don't (equal power), blended by how alike the place's grains are; never above
 *    unity for one grain alone. Density changes the texture, not the level: no pumping.
 * Memory: the tape length is the nature in tenths of a second at 48 kHz (a place at
 * samplerate=half holds twice the seconds in the same bytes). */

#define GRN_MAXV  32
#define GRN_TAB   257
enum { GRN_HANN, GRN_GAUSS, GRN_TUKEY, GRN_BH, GRN_EXPODEC, GRN_REXPODEC, GRN_EDGE };

typedef struct {
	int32_t ip;           /* read position: whole samples (in the tape, or in the voice's segment) */
	float   fp;           /*   and the fraction, 0..1 */
	float   rate, drate;  /* tape samples per sample (negative: backwards); rate *= drate each sample */
	float   ph, inc;      /* window phase 0..1; inc 0: the voice is free */
	float   gl, gr, amp;
	float   fade, fstep;  /* a fade on top of the window (a captured freeze's crossfade) */
	float   edge;         /* GRN_EDGE: the fade-in/out fraction of a flat window */
	int32_t wt, hq, base; /* window, read twice a sample, segment start (segment mode) */
} grn_voice;

typedef struct {
	float   half[2][32], combo[2][32];
	int32_t pos;
	int32_t still;        /* samples since a 2x voice last gave anything: past 32, the taps are all zero */
} grn_hb;

typedef struct {
	grn_voice v[GRN_MAXV];
	grn_hb  hb;
	float   ni;           /* the last square root of the window power (a guess for the next) */
	int32_t nv;           /* voices this place lets sound */
	int32_t seg;          /* 0: one guarded tape; else every voice reads a ring of `seg` at its base */
} grn_eng;

/* a ring of L samples stored at b[1..L], with b[0] = b[L], b[L+1] = b[1], b[L+2] = b[2] (wrapped) so
 * the four taps of a read never need wrapping themselves */
#define GRN_TAPE(nat) ((int32_t)(scq_clamp((nat), 0.5f, 6.8f) * (float)(SCQ_RATE / 20)) * 2)
static uint32_t grn_mem_tape(float nature) { return (uint32_t)sizeof(grn_eng) + (uint32_t)(GRN_TAPE(nature) + 4) * 2u; }
static int16_t *grn_tape(node *n, int32_t *L)
{
	*L = (int32_t)((n->memlen - (uint32_t)sizeof(grn_eng)) / 2u) - 4;
	return (int16_t *)((grn_eng *)n->mem + 1);
}

/* log2, to about 1e-5 (scq_log2 is a rough one, and one high: scq_log2(1) is 1.005) */
static inline float grn_log2(float x)
{
	if (!(x > 1e-30f)) return -100.f;
	union { float f; int32_t i; } u;
	u.f = x;
	float e = (float)(((u.i >> 23) & 255) - 127);
	u.i = (u.i & ~(255 << 23)) | (127 << 23);
	float m = u.f, t = (m - 1.f) / (m + 1.f), t2 = t * t;
	return e + 2.885390f * t * (1.f + t2 * (0.333333f + t2 * (0.2f + t2 * 0.142857f)));
}

static inline float grn_lim(float x)         /* linear to 0.8, then a soft knee to 1 */
{
	float a = scq_abs(x);
	if (!(a < 1e6f)) return 0.f;
	if (a <= 0.8f) return x;
	float y = 0.8f + 0.2f * scq_tanh((a - 0.8f) * 5.f);
	return x < 0.f ? -y : y;
}

static inline float grn_hp(float x, float *x1, float *y1, float hz)   /* a one-pole highpass */
{
	float y = x - *x1 + (1.f - 6.2831853f * hz * INV_SR) * *y1;
	if (scq_abs(y) < 1e-15f) y = 0.f;
	*x1 = x; *y1 = y;
	return y;
}
static inline float grn_dc(float x, float *x1, float *y1)   /* 5 Hz; not-a-number comes in as 0, wild input clamped */
{
	return grn_hp(x == x ? scq_clamp(x, -4.f, 4.f) : 0.f, x1, y1, 5.f);
}

static inline int16_t grn_q16(float x, uint32_t *rng)      /* round with a TPDF dither of one step */
{
	uint32_t r = scq_rng(rng);
	float d = ((float)(r & 0xffffu) - (float)(r >> 16)) * (1.f / 65536.f);
	float v = scq_clamp(x, -1.f, 1.f) * 32766.f + d + 32768.5f;
	int32_t q = (int32_t)v - 32768;
	return (int16_t)(q > 32767 ? 32767 : (q < -32767 ? -32767 : q));
}
#define GRN_FROM16 (1.f / 32766.f)

static inline void grn_put(int16_t *b, int32_t L, int32_t w, float x, uint32_t *rng)
{
	int16_t s = grn_q16(x, rng);
	b[w + 1] = s;
	if (w == L - 1) b[0] = s;
	if (w < 2) b[L + 1 + w] = s;
}

static inline float grn_hermite(float xm, float x0, float x1, float x2, float f)
{
	float c1 = 0.5f * (x1 - xm);
	float c2 = xm - 2.5f * x0 + 2.f * x1 - 0.5f * x2;
	float c3 = 0.5f * (x2 - xm) + 1.5f * (x0 - x1);
	return ((c3 * f + c2) * f + c1) * f + x0;
}
/* a guarded tape at ip + f (ip 0..L-1) */
static inline float grn_read(const int16_t *b, int32_t ip, float f)
{
	return grn_hermite((float)b[ip], (float)b[ip + 1], (float)b[ip + 2], (float)b[ip + 3], f) * GRN_FROM16;
}
/* a plain ring of n at ip + f */
static inline float grn_read_seg(const int16_t *b, int32_t n, int32_t ip, float f)
{
	int32_t a = ip - 1 < 0 ? ip - 1 + n : ip - 1, c = ip + 1 >= n ? ip + 1 - n : ip + 1, d = ip + 2 >= n ? ip + 2 - n : ip + 2;
	return grn_hermite((float)b[a], (float)b[ip], (float)b[c], (float)b[d], f) * GRN_FROM16;
}

static inline void grn_step(int32_t *ip, float *fp, float d, int32_t L)
{
	float f = *fp + d, fl = scq_floor(f);
	int32_t i = *ip + (int32_t)fl;
	*fp = f - fl;
	while (i >= L) i -= L;
	while (i < 0) i += L;
	*ip = i;
}

static inline float grn_window(int32_t wt, float ph, float fr)
{
	if (wt == GRN_EDGE) {                         /* flat, with smooth edges a fraction fr long */
		float x = scq_min(ph, 1.f - ph) / fr;
		if (x >= 1.f) return 1.f;
		if (x <= 0.f) return 0.f;
		return x * x * (3.f - 2.f * x);
	}
	float x = scq_clamp(ph, 0.f, 1.f) * 256.f;
	int32_t i = (int32_t)x;
	if (i > 255) i = 255;
	const float *t = GRN_WIN + wt * GRN_TAB + i;
	return t[0] + (x - (float)i) * (t[1] - t[0]);
}

static inline float grn_hb_one(const float *half, const float *combo, int32_t p)
{
	float y = combo[(p - (GRN_HB_K - 1)) & 31];
	for (int j = 0; j < GRN_HB_K; j++)
		y += GRN_HB[j] * (half[(p - j) & 31] + half[(p - (2 * GRN_HB_K - 1 - j)) & 31]);
	return y;
}
/* on: what the 2x voices give at t, half: at t + 1/2, dry: the 1x voices at t; out 15 samples late */
static inline void grn_hb_push(grn_hb *h, float onl, float halfl, float dryl, float onr, float halfr, float dryr, float *l, float *r)
{
	int32_t p = h->pos = (h->pos + 1) & 31;
	h->half[0][p] = halfl; h->combo[0][p] = GRN_HB_C * onl + dryl;
	h->half[1][p] = halfr; h->combo[1][p] = GRN_HB_C * onr + dryr;
	if (halfl != 0.f || halfr != 0.f || onl != 0.f || onr != 0.f) h->still = 0;
	else if (h->still < 64) h->still++;
	if (h->still >= 2 * GRN_HB_K) {                  /* nothing at 2x lately: the dry voices, delayed alike */
		int32_t q = (p - (GRN_HB_K - 1)) & 31;
		*l = h->combo[0][q]; *r = h->combo[1][q];
		return;
	}
	*l = grn_hb_one(h->half[0], h->combo[0], p);
	*r = grn_hb_one(h->half[1], h->combo[1], p);
}

static grn_voice *grn_take(grn_eng *e)
{
	for (int k = 0; k < e->nv; k++) if (e->v[k].inc == 0.f) return &e->v[k];
	return 0;
}

/* how far behind the write head a grain may start, so that it never reads what isn't written yet
 * nor what has been written over: d is the delay in samples, dur the length (shortened if it can't
 * fit), rates the fastest and slowest the grain plays at, moving 1 if the tape is being written */
static float grn_fit(float d, float *dur, float rmin, float rmax, int32_t L, float moving)
{
	float up = scq_max(0.f, rmax - moving), back = scq_max(0.f, moving - rmin);
	float margin = 5.f + 0.5f * scq_max(scq_abs(rmax), scq_abs(rmin));
	float room = (float)L - 10.f - margin;
	if ((up + back) * *dur > room) *dur = room / (up + back);
	if (*dur < 8.f) *dur = 8.f;
	float lo = margin + *dur * up, hi = (float)L - 10.f - *dur * back;
	return scq_clamp(d, lo, scq_max(lo, hi));
}

/* start a grain: delay d behind tape index wi (the sample just written), t0 samples into its life
 * (a sub-sample onset), dur samples long */
static void grn_go(grn_voice *v, int32_t L, int32_t wi, float d, float rate, float drate, float dur, float t0,
                   int32_t wt, float pan, float amp)
{
	int32_t di = (int32_t)d;
	float df = d - (float)di;
	v->ip = wi - di;
	v->fp = 0.f;
	if (df > 0.f) { v->ip -= 1; v->fp = 1.f - df; }
	while (v->ip < 0) v->ip += L;
	while (v->ip >= L) v->ip -= L;
	if (t0 > 0.f) grn_step(&v->ip, &v->fp, t0 * (rate - 1.f), L);   /* (for rate 1 the read stays on the sample) */
	v->rate = rate; v->drate = drate;
	v->inc = 1.f / scq_max(dur, 2.f);
	v->ph = t0 * v->inc;
	float rmax = drate == 1.f ? scq_abs(rate) : scq_max(scq_abs(rate), scq_abs(rate) * scq_exp2(grn_log2(drate) * dur));
	v->hq = rmax > 1.01f;
	pan = scq_clamp(pan, 0.f, 1.f);
	v->gl = 1.41421356f * scq_sin2pi(0.25f * pan + 0.25f);
	v->gr = 1.41421356f * scq_sin2pi(0.25f * pan);
	v->amp = amp; v->fade = 1.f; v->fstep = 0.f;
	v->wt = wt; v->edge = 0.1f; v->base = 0;
}

/* one sample of every voice; c: 0 the grains are unlike (equal power) .. 1 alike (amplitude) */
static void grn_render(grn_eng *e, const int16_t *b, int32_t L, float c, float *ol, float *orr)
{
	float onl = 0.f, onr = 0.f, hl = 0.f, hr = 0.f, dl = 0.f, dr = 0.f, A = 0.f, P = 0.f;
	const int32_t seg = e->seg;
	for (int k = 0; k < e->nv; k++) {
		grn_voice *v = &e->v[k];
		if (v->inc == 0.f) continue;
		float w = grn_window(v->wt, v->ph, v->edge);
		if (v->fstep != 0.f) {
			w *= v->fade;
			v->fade += v->fstep;
			if (v->fade >= 1.f) { v->fade = 1.f; v->fstep = 0.f; }
			if (v->fade <= 0.f) { v->inc = 0.f; continue; }
		}
		const int16_t *bb = b + v->base;
		const int32_t len = seg ? seg : L;
		float s = (seg ? grn_read_seg(bb, len, v->ip, v->fp) : grn_read(bb, v->ip, v->fp)) * w * v->amp;
		if (v->hq) {
			float wh = grn_window(v->wt, v->ph + 0.5f * v->inc, v->edge) * (v->fstep != 0.f ? v->fade : 1.f);
			int32_t i2 = v->ip; float f2 = v->fp;
			grn_step(&i2, &f2, 0.5f * v->rate, len);
			float sh = (seg ? grn_read_seg(bb, len, i2, f2) : grn_read(bb, i2, f2)) * wh * v->amp;
			onl += s * v->gl; onr += s * v->gr;
			hl += sh * v->gl; hr += sh * v->gr;
		} else {
			dl += s * v->gl; dr += s * v->gr;
		}
		A += w; P += w * w;
		grn_step(&v->ip, &v->fp, v->rate, len);
		v->rate *= v->drate;
		v->ph += v->inc;
		if (v->ph >= 1.f) v->inc = 0.f;
	}
	float ni = scq_sqrt_from(P, e->ni);
	e->ni = ni > 1e-3f ? ni : 1.f;
	float nn = ni + c * (A - ni);
	float g = nn > 1.f ? 1.f / nn : 1.f;
	grn_hb_push(&e->hb, onl * g, hl * g, dl * g, onr * g, hr * g, dr * g, ol, orr);
}

/* an exponential interval, mean 1 (Poisson onsets) */
static inline float grn_expo(uint32_t *rng)
{
	float u = 1.f - scq_rand01(rng);
	return scq_clamp(-0.693147f * grn_log2(u), 0.05f, 8.f);
}


/* how alike a place's grains are, from how far apart (in samples) the moments they read lie */
static inline float grn_alike(float apart) { return 1.f / (1.f + scq_max(apart, 0.f) * 2000.f * INV_SR); }

/* ------------------------------------------------------------------ live-input granulators */

/* the tape's write side, shared: s[0] the write index, s[1], s[2] the DC blocker */
static inline int32_t grn_write(node *n, int16_t *b, int32_t L, float x)
{
	int32_t w = (int32_t)n->s[0] + 1;
	if (w >= L || w < 0) w = 0;
	grn_put(b, L, w, grn_dc(x, &n->s[1], &n->s[2]), &n->rng);
	n->s[0] = (float)w;
	return w;
}

/* grains — the main granulator (after Roads, Truax's GSAMX, Granulator II): position is how far
 * back (0 now, 1 the far end of the tape), spray scatters it further back, size 4 ms - 1 s,
 * density the overlap (a quarter to 24 deep), pitch in octaves, spread the stereo width, freeze
 * holds the tape. s: 0-2 tape, 3 onset countdown */
static void run_grains(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L; int16_t *b = grn_tape(n, &L);
	float pos = scq_clamp(in[1][0], 0.f, 1.f), spray = scq_clamp(in[2][0], 0.f, 1.f);
	float size = scq_clamp(in[3][0], 0.f, 1.f), dens = scq_clamp(in[4][0], 0.f, 1.f);
	float r = scq_exp2(scq_clamp(in[5][0], -4.f, 4.f)), spread = scq_clamp(in[6][0], 0.f, 1.f);
	int frozen = in[7][0] > 0.5f;
	int32_t wt = (int32_t)scq_clamp(n->opt[0], 0.f, 5.f);
	int sync = n->opt[1] > 0.5f;
	float rev = scq_clamp(n->opt[2] * 0.01f, 0.f, 1.f);
	float dur = SR * 0.004f * scq_exp2(size * 7.966f);
	float lap = 0.25f * scq_exp2(dens * 6.585f);
	float period = scq_max(dur / lap, 1.f);
	float span = (float)L - 16.f;
	float c = grn_alike(spray * span * 0.5f + dur * scq_abs(1.f - r) + rev * dur * 2.f);
	float cnt = n->s[3];
	cnt = scq_min(cnt, 8.f * period);   /* never wait on a density or size since left: no grain is further off than these could draw */
	e->nv = GRN_MAXV; e->seg = 0;
	LOOP {
		int32_t w = frozen ? (int32_t)n->s[0] : grn_write(n, b, L, in[0][i]);
		while (cnt <= 0.f) {
			float t0 = -cnt;
			cnt += sync ? period : period * grn_expo(&n->rng);
			grn_voice *v = grn_take(e);
			if (!v) continue;
			float rr = scq_rand01(&n->rng) < rev ? -r : r, dd = dur;
			/* off its own pitch, grains on a grid would step their phase alike and comb; a little
			 * scatter (up to the distance they drift apart, 20 ms at most) makes them add as power */
			float d = 4.f + pos * span + spray * span * scq_rand01(&n->rng);
			d = grn_fit(d, &dd, rr, rr, L, frozen ? 0.f : 1.f);
			if (r != 1.f) d = grn_fit(d + scq_min(dur * scq_abs(1.f - r), 0.02f * SR) * scq_rand01(&n->rng), &dd, rr, rr, L, frozen ? 0.f : 1.f);
			if (r == 1.f && rr > 0.f) d = scq_floor(d + 0.5f);   /* at its own pitch a grain reads the samples themselves */
			grn_go(v, L, w, d, rr, 1.f, dd, t0, wt, 0.5f + spread * (scq_rand01(&n->rng) - 0.5f), 1.f);
		}
		cnt -= 1.f;
		grn_render(e, b, L, c, &n->out[0][i], &n->out[1][i]);
	}
	n->s[3] = cnt;
}

/* glisson — Roads' glissons: every grain glides in pitch from its start to its end. glide is the
 * range in octaves (negative glides down), spread how many go the other way and how far their
 * start pitches scatter (and their place in the stereo). s: 0-2 tape, 3 countdown */
static void run_glisson(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L; int16_t *b = grn_tape(n, &L);
	float dens = scq_clamp(in[1][0], 0.f, 1.f), size = scq_clamp(in[2][0], 0.f, 1.f);
	float glide = scq_clamp(in[3][0], -4.f, 4.f), spread = scq_clamp(in[4][0], 0.f, 1.f);
	int32_t wt = (int32_t)scq_clamp(n->opt[0], 0.f, 5.f);
	float dur = SR * 0.01f * scq_exp2(size * 5.644f);          /* 10 ms .. 0.5 s */
	float lap = 0.25f * scq_exp2(dens * 6.f);                  /* .. 16 deep */
	float period = scq_max(dur / lap, 1.f), span = (float)L - 16.f;
	float cnt = n->s[3];
	cnt = scq_min(cnt, 8.f * period);   /* never wait on a density or size since left: no grain is further off than these could draw */
	e->nv = GRN_MAXV; e->seg = 0;
	LOOP {
		int32_t w = grn_write(n, b, L, in[0][i]);
		while (cnt <= 0.f) {
			float t0 = -cnt;
			cnt += period * grn_expo(&n->rng);
			grn_voice *v = grn_take(e);
			if (!v) continue;
			float g = glide * (1.f + spread * (scq_rand01(&n->rng) - 0.5f));
			if (scq_rand01(&n->rng) < spread * 0.5f) g = -g;
			float p0 = spread * (scq_rand01(&n->rng) - 0.5f);
			if (p0 + g > 3.5f) p0 = 3.5f - g;
			if (p0 + g < -4.f) p0 = -4.f - g;
			float r0 = scq_exp2(p0), r1 = scq_exp2(p0 + g), dd = dur;
			float d = grn_fit(4.f + scq_rand01(&n->rng) * span * 0.5f, &dd, scq_min(r0, r1), scq_max(r0, r1), L, 1.f);
			grn_go(v, L, w, d, r0, scq_exp2(g / dd), dd, t0, wt, 0.5f + spread * (scq_rand01(&n->rng) - 0.5f), 1.f);
		}
		cnt -= 1.f;
		grn_render(e, b, L, 0.f, &n->out[0][i], &n->out[1][i]);
	}
	n->s[3] = cnt;
}

/* harmonicgrains — a granular harmoniser choir: grains of what comes in, each transposed to a
 * tone of the chord on pitch, every tone in its own place in the stereo */
static const float GRN_CHORDS[8][7] = {         /* octaves; first entry: how many */
	{ 4, 0.f, 1.f, -1.f, 2.f, 0, 0 },
	{ 5, 0.f, 0.583333f, 1.f, 1.583333f, -0.416667f, 0 },
	{ 5, 0.f, 0.333333f, 0.583333f, 1.f, 1.333333f, 0 },
	{ 5, 0.f, 0.25f, 0.583333f, 1.f, 1.25f, 0 },
	{ 6, 0.f, 1.f, 1.584963f, 2.f, 2.321928f, 2.584963f },     /* harmonics 1 2 3 4 5 6 */
	{ 5, 0.f, 0.2f, 0.4f, 0.6f, 0.8f, 0 },                      /* slendro, five equal steps */
	{ 6, 0.f, 0.166667f, 0.333333f, 0.5f, 0.666667f, 0.833333f },
	{ 4, -0.083333f, 0.f, 0.083333f, 0.166667f, 0, 0 },
};
static void run_harmonicgrains(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L; int16_t *b = grn_tape(n, &L);
	float root = scq_clamp(in[1][0], -3.f, 2.f), dens = scq_clamp(in[2][0], 0.f, 1.f), size = scq_clamp(in[3][0], 0.f, 1.f);
	int ch = (int)scq_clamp(n->opt[0], 0.f, 7.f);
	const float *chord = GRN_CHORDS[ch];
	int nt = (int)chord[0];
	float dur = SR * 0.02f * scq_exp2(size * 3.907f);          /* 20 .. 300 ms */
	float lap = 1.f * scq_exp2(dens * 4.585f);                 /* 1 .. 24 deep */
	float period = scq_max(dur / lap, 1.f), reach = scq_min(0.15f * SR, (float)L * 0.5f);
	float cnt = n->s[3];
	cnt = scq_min(cnt, 8.f * period);   /* never wait on a density or size since left: no grain is further off than these could draw */
	e->nv = GRN_MAXV; e->seg = 0;
	LOOP {
		int32_t w = grn_write(n, b, L, in[0][i]);
		while (cnt <= 0.f) {
			float t0 = -cnt;
			cnt += period * grn_expo(&n->rng);
			grn_voice *v = grn_take(e);
			if (!v) continue;
			int k = (int)(scq_rand01(&n->rng) * (float)nt);
			float r = scq_exp2(scq_clamp(root + chord[1 + k] + 0.005f * scq_noise(&n->rng), -4.f, 3.5f)), dd = dur;
			float d = grn_fit(4.f + scq_rand01(&n->rng) * reach, &dd, r, r, L, 1.f);
			float pan = nt > 1 ? 0.1f + 0.8f * (float)((k * 3) % nt) / (float)(nt - 1) : 0.5f;
			grn_go(v, L, w, d, r, 1.f, dd, t0, GRN_HANN, pan, 1.f);
		}
		cnt -= 1.f;
		grn_render(e, b, L, 0.f, &n->out[0][i], &n->out[1][i]);
	}
	n->s[3] = cnt;
}

/* particles — a stochastic cloud after Xenakis's screens: onsets Poisson, and every grain's pitch,
 * length, place in the stereo and moment drawn from a distribution (dist=) around one of two
 * screens; screen morphs from A (a tight shimmer: near unison, 15 ms, close to now, centred) to
 * B (scattered: two octaves of pitch on a Xenakis sieve, 180 ms, half a second back, wide, some
 * reversed). */
static float grn_dist(int kind, uint32_t *rng)        /* about unit spread, never wild */
{
	float u = scq_clamp(scq_rand01(rng), 0.002f, 0.998f), x;
	switch (kind) {
	case 1: x = 3.4641f * (u - 0.5f); break;                                        /* uniform */
	case 2: { float a = 0.5f * (u - 0.5f);                                          /* cauchy: tan(pi (u - 1/2)) */
		x = 0.3f * scq_sin2pi(a) / scq_max(scq_sin2pi(a + 0.25f), 0.01f); break; }
	case 3: x = -0.693147f * grn_log2(u) * (scq_rand01(rng) < 0.5f ? -1.f : 1.f); break;   /* exponential, either way */
	case 4: x = 0.551f * 0.693147f * grn_log2(u / (1.f - u)); break;                /* logistic */
	default: x = (scq_rand01(rng) + scq_rand01(rng) + scq_rand01(rng) + u - 2.f) * 1.732f;  /* gauss (four uniforms) */
	}
	return scq_clamp(x, -3.f, 3.f);
}
static const uint8_t GRN_SIEVE[12] = { 0, 1, 1, 3, 3, 5, 6, 6, 6, 9, 9, 11 };   /* (3,0) u (4,1) u (12,11): nearest member below */
static void run_particles(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L; int16_t *b = grn_tape(n, &L);
	float dens = scq_clamp(in[1][0], 0.f, 1.f), x = scq_clamp(in[2][0], 0.f, 1.f), pc = scq_clamp(in[3][0], -3.f, 2.f);
	int dist = (int)scq_clamp(n->opt[0], 0.f, 4.f);
	float rate = 2.f * scq_exp2(dens * 7.644f);                /* 2 .. 400 grains a second */
	float pdev = 0.02f + x * 0.98f, dmean = 0.015f * scq_exp2(x * 3.585f), ddev = 0.3f + 0.5f * x;
	float pandev = 0.15f + 0.35f * x, tdev = (0.03f + 0.22f * x) * SR, revp = 0.3f * x;
	float span = (float)L - 16.f, period = SR / rate;
	float cnt = n->s[3];
	cnt = scq_min(cnt, 8.f * period);   /* never wait on a density or size since left: no grain is further off than these could draw */
	e->nv = GRN_MAXV; e->seg = 0;
	LOOP {
		int32_t w = grn_write(n, b, L, in[0][i]);
		while (cnt <= 0.f) {
			float t0 = -cnt;
			cnt += period * grn_expo(&n->rng);
			grn_voice *v = grn_take(e);
			if (!v) continue;
			float p = pc + pdev * grn_dist(dist, &n->rng);
			if (scq_rand01(&n->rng) < x) {                     /* onto the sieve */
				float st = p * 12.f, fl = scq_floor(st);
				int32_t sem = (int32_t)fl, oc = sem >= 0 ? sem / 12 : -((11 - sem) / 12);
				p = ((float)(oc * 12 + GRN_SIEVE[sem - oc * 12])) / 12.f;
			}
			float r = scq_exp2(scq_clamp(p, -4.f, 3.5f));
			if (scq_rand01(&n->rng) < revp) r = -r;
			float dd = SR * dmean * scq_exp2(ddev * grn_dist(dist, &n->rng));
			float d = 4.f + scq_abs(tdev * grn_dist(dist, &n->rng));
			d = grn_fit(scq_min(d, span), &dd, r, r, L, 1.f);
			grn_go(v, L, w, d, r, 1.f, dd, t0, GRN_HANN, 0.5f + pandev * grn_dist(dist, &n->rng) * 0.5f, 1.f);
		}
		cnt -= 1.f;
		grn_render(e, b, L, 0.f, &n->out[0][i], &n->out[1][i]);
	}
	n->s[3] = cnt;
}

/* granularverb — a reverb made of grains: dozens of tiny grains read a long delay at random times,
 * and what they make is fed back in, softly darkened; size sets the reach and the decay (0.5 to
 * 16 s), density how many overlap (4 to 32). s: 0-2 tape, 3 countdown, 4 feedback, 5 damping */
static void run_granularverb(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L; int16_t *b = grn_tape(n, &L);
	float size = scq_clamp(in[1][0], 0.f, 1.f), dens = scq_clamp(in[2][0], 0.f, 1.f);
	float reach = scq_min((0.05f + 0.5f * size) * SR, (float)L - 0.05f * SR);
	float t60 = 0.5f * scq_exp2(size * 5.f);
	float mean = (0.5f * (0.005f * SR + reach)) * INV_SR + 0.012f;
	float fb = scq_exp2(-9.966f * mean / t60);
	float lap = 4.f * scq_exp2(dens * 3.f);
	float mdur = 0.022f * SR, period = scq_max(mdur / lap, 1.f);
	float damp = scq_coef_hz(7000.f - 4000.f * size, SR);
	float cnt = n->s[3], y = n->s[4], lp = n->s[5];
	cnt = scq_min(cnt, 8.f * period);   /* never wait on a density or size since left: no grain is further off than these could draw */
	e->nv = GRN_MAXV; e->seg = 0;
	LOOP {
		lp += damp * (y - lp);
		int32_t w = grn_write(n, b, L, grn_lim(in[0][i] + fb * grn_hp(lp, &n->s[6], &n->s[7], 25.f)));
		while (cnt <= 0.f) {
			float t0 = -cnt;
			cnt += period * grn_expo(&n->rng);
			grn_voice *v = grn_take(e);
			if (!v) continue;
			float r = 1.f + 0.0015f * scq_noise(&n->rng), dd = mdur * (0.45f + 1.1f * scq_rand01(&n->rng));
			float d = grn_fit(0.005f * SR + scq_rand01(&n->rng) * reach, &dd, r, r, L, 1.f);
			grn_go(v, L, w, d, r, 1.f, dd, t0, GRN_HANN, scq_rand01(&n->rng), 1.f);
		}
		cnt -= 1.f;
		float l, rr;
		grn_render(e, b, L, 0.f, &l, &rr);
		y = 0.5f * (l + rr);
		if (scq_abs(lp) < 1e-15f) lp = 0.f;
		n->out[0][i] = l * 0.7f; n->out[1][i] = rr * 0.7f;
	}
	n->s[3] = cnt; n->s[4] = y; n->s[5] = lp;
}

/* graindelay — a granular delay: grains read the line at time (10 ms to the tape's end) give or take
 * jitter, each pitched and placed in the stereo, and feed back through themselves (Portal, GR-1;
 * clean). s: 0-2 tape, 3 countdown, 4 feedback sample */
static void run_graindelay(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L; int16_t *b = grn_tape(n, &L);
	float tm = scq_clamp(in[1][0], 0.f, 1.f), jit = scq_clamp(in[2][0], 0.f, 1.f);
	float r = scq_exp2(scq_clamp(in[3][0], -3.f, 3.f)), fb = 0.98f * scq_clamp(in[4][0], 0.f, 1.f), dens = scq_clamp(in[5][0], 0.f, 1.f);
	float dl = 0.01f * SR + tm * ((float)L - 0.06f * SR);
	float dur = scq_clamp(dl * 0.5f, 0.02f * SR, 0.15f * SR);
	float lap = 1.f * scq_exp2(dens * 3.585f);                 /* 1 .. 12 deep */
	float period = scq_max(dur / lap, 1.f);
	float c = grn_alike(jit * dl * 0.5f + dur * scq_abs(1.f - r));
	float cnt = n->s[3], y = n->s[4];
	cnt = scq_min(cnt, 8.f * period);   /* never wait on a density or size since left: no grain is further off than these could draw */
	e->nv = GRN_MAXV; e->seg = 0;
	LOOP {
		int32_t w = grn_write(n, b, L, grn_lim(in[0][i] + fb * grn_hp(y, &n->s[5], &n->s[6], 25.f)));   /* (no rumble builds up in the loop) */
		while (cnt <= 0.f) {
			float t0 = -cnt;
			cnt += period * grn_expo(&n->rng);
			grn_voice *v = grn_take(e);
			if (!v) continue;
			float dd = dur;
			float d = grn_fit(dl * (1.f + jit * 0.5f * scq_noise(&n->rng)), &dd, r, r, L, 1.f);
			if (r == 1.f) d = scq_floor(d + 0.5f);
			grn_go(v, L, w, d, r, 1.f, dd, t0, GRN_HANN, 0.5f + 0.4f * scq_noise(&n->rng), 1.f);
		}
		cnt -= 1.f;
		float l, rr;
		grn_render(e, b, L, c, &l, &rr);
		y = 0.5f * (l + rr);
		n->out[0][i] = l; n->out[1][i] = rr;
	}
	n->s[3] = cnt; n->s[4] = y;
}

/* grainfreeze — capture the last moment and live inside it: the tape is two halves, one records
 * while the other is held; a pulse into capture holds the half that just recorded (until the first
 * pulse it captures itself every half tape). Overlapping gauss grains, 6 deep, drift about it:
 * where they read wanders and jitters, their pitch drifts slowly (drift: 0 still .. 1 restless,
 * half a semitone). blend goes from what comes in (0) to the held moment (1). On a capture the
 * old grains fade out over 30 ms as the new ones fade in.
 * s: 0 write index in the recording half, 1-2 DC, 3 countdown, 4 recording half, 5 captured by
 * hand, 6 capture edge, 7 wander value, 8 wander target, 9 pause after a capture, 11 the held
 * half's seam (its oldest sample), 12 the held half's start, 13 started */
static void grn_capture(node *n, grn_eng *e, int32_t F, float dur)
{
	int32_t rec = (int32_t)n->s[4];
	int32_t seam = (int32_t)n->s[0] + 1;                 /* the oldest sample of the half just recorded */
	if (seam >= F) seam = 0;
	for (int k = 0; k < GRN_MAXV; k++) if (e->v[k].inc != 0.f) { e->v[k].fstep = -1.f / (0.03f * SR); if (e->v[k].fade > 1.f) e->v[k].fade = 1.f; }
	n->s[4] = (float)(1 - rec);                          /* record into the other half now */
	n->s[0] = -1.f;
	n->s[9] = 0.03f * SR + 2.f;                          /* after the old grains have gone */
	n->s[11] = (float)seam;
	n->s[12] = (float)(rec * F);                         /* the held half's start */
	for (int k = 0; k < 6; k++) {                        /* a full texture at once, fading in */
		grn_voice *v = grn_take(e);
		if (!v) break;
		float q = 0.25f * (float)F + 0.5f * (float)F * scq_rand01(&n->rng) - 0.5f * dur;
		int32_t ip = seam + (int32_t)q;
		if (ip >= F) ip -= F;
		grn_go(v, F, ip, 0.f, 1.f, 1.f, dur, (float)k * dur / 6.f, GRN_GAUSS, 0.5f + 0.6f * scq_noise(&n->rng) * 0.5f, 1.f);
		v->base = (int32_t)n->s[12];
		v->ip = ip; v->fp = 0.f;
		v->fade = 0.f; v->fstep = 1.f / (0.03f * SR);
	}
}
static uint32_t mem_grainfreeze(float nature) { return grn_mem_tape(nature); }
#if defined(__XTENSA__)   /* the ESP32's gcc 8.4 crashes (internal compiler error) on this one at -O2 */
__attribute__((optimize("O1")))
#endif
static void run_grainfreeze(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L; int16_t *b = grn_tape(n, &L);
	int16_t *raw = b + 1;                                /* two plain halves, no guards */
	int32_t F = L / 2;
	float blend = scq_clamp(in[2][0], 0.f, 1.f), drift = scq_clamp(in[3][0], 0.f, 1.f);
	float dur = scq_min(0.25f * SR, (float)F * 0.3f);
	float period = dur / 6.f;
	float cnt = n->s[3];
	cnt = scq_min(cnt, 8.f * period);   /* never wait on a density or size since left: no grain is further off than these could draw */
	e->nv = GRN_MAXV; e->seg = F;
	if (n->s[13] == 0.f) { n->s[13] = 1.f; n->s[12] = (float)F; n->s[8] = 0.0001f; }   /* start: record into half 0, hold the silent half 1 */
	LOOP {
		int cap = edge(in[1][i], &n->s[6]);
		if (cap) n->s[5] = 1.f;
		float x = grn_dc(in[0][i], &n->s[1], &n->s[2]);
		int32_t rec = (int32_t)n->s[4];
		if (n->s[9] > 0.f) n->s[9] -= 1.f;
		else {
			int32_t w = (int32_t)n->s[0] + 1;
			if (w >= F || w < 0) w = 0;
			raw[rec * F + w] = grn_q16(x, &n->rng);
			n->s[0] = (float)w;
			if (w == F - 1 && n->s[5] == 0.f) cap = 1;   /* not yet held by hand: it holds every half tape */
		}
		if (cap) grn_capture(n, e, F, dur);
		/* the wander: a slow random walk of the reading place and the pitch */
		if (scq_rand01(&n->rng) < 2.f * INV_SR) n->s[8] = scq_noise(&n->rng);
		n->s[7] += (n->s[8] - n->s[7]) * 3.f * INV_SR;
		while (cnt <= 0.f) {
			float t0 = -cnt;
			cnt += period * grn_expo(&n->rng);
			grn_voice *v = grn_take(e);
			if (!v) continue;
			float centre = 0.5f + 0.3f * drift * n->s[7];
			float jit = (0.01f + 0.05f * drift) * SR * scq_noise(&n->rng);
			float r = scq_exp2(drift * (0.04f * n->s[7] + 0.01f * scq_noise(&n->rng)));
			float q = centre * (float)F + jit - 0.5f * dur * r;
			q = scq_clamp(q, 8.f, (float)F - 8.f - dur * r);
			int32_t ip = (int32_t)n->s[11] + (int32_t)q;
			if (ip >= F) ip -= F;
			grn_go(v, F, ip, 0.f, r, 1.f, dur, t0, GRN_GAUSS, 0.5f + 0.3f * scq_noise(&n->rng), 1.f);
			v->base = (int32_t)n->s[12];
			v->ip = ip; v->fp = q - scq_floor(q);
		}
		cnt -= 1.f;
		float l, rr;
		grn_render(e, raw, F, 0.f, &l, &rr);
		n->out[0][i] = in[0][i] * (1.f - blend) + l * blend;
		n->out[1][i] = in[0][i] * (1.f - blend) + rr * blend;
		n->out[0][i] = scq_clamp(n->out[0][i], -4.f, 4.f);
		n->out[1][i] = scq_clamp(n->out[1][i], -4.f, 4.f);
	}
	n->s[3] = cnt;
}

/* scrub — tape and grains: record (a pulse records at least a quarter of the tape, holding it keeps
 * recording), then position (0..1 across the recording) is where the head is, smoothed by smooth
 * (1 ms .. 1 s). The head's speed and direction play the sound: below normal speed grains keep
 * their pitch and stretch time, above it the pitch rises like tape; stopped, a grain loop holds
 * the spot (jittered, so it doesn't buzz). Before anything is recorded it scrubs the live tape
 * (1 = now). s: 0-2 tape, 3 countdown, 4 head, 5 speed, 6 recorded length (0: live), 7 recording,
 * 8 record edge, 9 recorded so far, 10 direction */
static void run_scrub(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L; int16_t *b = grn_tape(n, &L);
	float sm = scq_clamp(in[3][0], 0.f, 1.f);
	float k = scq_coef_time(0.001f * scq_exp2(sm * 9.966f), SR);
	float dur = 0.06f * SR, period = dur * 0.25f;
	float cnt = n->s[3], head = n->s[4], vel = n->s[5], dir = n->s[10] < 0.f ? -1.f : 1.f;
	cnt = scq_min(cnt, 8.f * period);   /* never wait on a density or size since left: no grain is further off than these could draw */
	e->nv = 12; e->seg = 0;
	LOOP {
		if (edge(in[2][i], &n->s[8])) { n->s[7] = 1.f; n->s[9] = 0.f; n->s[0] = -1.f; }
		int live = n->s[6] == 0.f && n->s[7] == 0.f;
		int32_t w = (int32_t)n->s[0];
		if (live) w = grn_write(n, b, L, in[0][i]);
		else if (n->s[7] != 0.f) {
			w = grn_write(n, b, L, in[0][i]);
			n->s[9] += 1.f;
			if (n->s[9] >= (float)(L - 1) || (in[2][i] <= 0.5f && n->s[9] >= 0.25f * (float)L)) { n->s[7] = 0.f; n->s[6] = n->s[9]; }
		}
		float len = live ? (float)L : scq_max(n->s[7] != 0.f ? n->s[9] : n->s[6], 64.f);
		float target = scq_clamp(in[1][i], 0.f, 1.f) * len;
		float prev = head;
		head += k * (target - head);
		vel += 0.05f * ((head - prev) - vel);
		if (scq_abs(vel) < 1e-12f) vel = 0.f;
		float av = scq_abs(vel);
		if (av > 0.02f) dir = vel < 0.f ? -1.f : 1.f;
		while (cnt <= 0.f) {
			float t0 = -cnt;
			cnt += period;
			grn_voice *v = grn_take(e);
			if (!v) continue;
			float r = dir * scq_clamp(scq_max(av, 1.f), 1.f, 8.f), dd = dur;
			float jit = (1.f - scq_min(av, 1.f)) * 0.25f * dur * scq_noise(&n->rng);
			float d;
			if (live) d = grn_fit((float)L - 8.f - head + jit, &dd, r, r, L, 1.f);
			else {                                       /* a recording: stay inside it */
				float lo = 4.f + (r < 0.f ? dd * -r : 0.f), hi = len - 6.f - (r > 0.f ? dd * r : 0.f);
				if (hi < lo) { dd = scq_max((len - 12.f) / scq_abs(r), 8.f); lo = 4.f + (r < 0.f ? dd * -r : 0.f); hi = scq_max(lo, len - 6.f - (r > 0.f ? dd * r : 0.f)); }
				float p = scq_clamp(head + jit, lo, hi);
				d = (float)w - p;                        /* (as a delay behind the last sample written) */
				while (d < 0.f) d += (float)L;
			}
			grn_go(v, L, w < 0 ? 0 : w, d, r, 1.f, dd, t0, GRN_HANN, 0.5f, 1.f);
		}
		cnt -= 1.f;
		float l, rr;
		grn_render(e, b, L, scq_max(0.f, 1.f - 4.f * scq_abs(1.f - av)), &l, &rr);
		n->out[0][i] = 0.5f * (l + rr);
	}
	n->s[3] = cnt; n->s[4] = head; n->s[5] = vel; n->s[10] = dir;
}

/* beatgrains — rhythmic grains for tempo-locked stutters: each clock pulse fires a grain, or a
 * burst of burst= grains spread over the beat (ratchets, left and right in turn), starting on one
 * of the last `slices` beats (1 - 16) the place heard, so a stutter always begins on a beat. pitch
 * steps follow pattern= (semitones, a step per grain) on top of the pitch inlet; length is the
 * grain against its share of the beat (5% .. twice). Edges are 2 ms, so attacks stay sharp.
 * Without a clock it fires four a second on equal slices of the tape.
 * mem: engine, tape, then the beat log. s: 0-2 tape, 3 clock edge, 4 samples since the last beat,
 * 5 beat length, 6 grains of the burst still to come, 7 countdown to the next, 8 step count,
 * 9 beats logged */
#define GRN_BEATS 16
static const int8_t GRN_PATTERN[6][8] = {
	{ 0, 0, 0, 0, 0, 0, 0, 0 }, { 0, 2, 4, 5, 7, 9, 11, 12 }, { 0, -1, -3, -5, -7, -8, -10, -12 },
	{ 0, 12, 0, -12, 0, 12, 24, 0 }, { 0, 7, 12, 7, 0, -5, 0, 7 }, { 0, 0, 0, 0, 0, 0, 0, 0 },
};
static uint32_t mem_beatgrains(float nature) { return grn_mem_tape(nature) + GRN_BEATS * 4u; }
static void run_beatgrains(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	int32_t L = (int32_t)((n->memlen - (uint32_t)sizeof(grn_eng) - GRN_BEATS * 4u) / 2u) - 4;
	int16_t *b = (int16_t *)(e + 1);
	int32_t *log = (int32_t *)(void *)(b + ((L + 4 + 1) & ~1));
	float slices = 1.f + scq_floor(scq_clamp(in[2][0], 0.f, 1.f) * 15.f + 0.5f);
	float pitch = scq_clamp(in[3][0], -3.f, 3.f), len = scq_clamp(in[4][0], 0.f, 1.f);
	int burst = (int)scq_clamp(n->opt[0], 1.f, 8.f), pat = (int)scq_clamp(n->opt[1], 0.f, 5.f);
	int clocked = (n->patched & 2u) != 0;
	e->nv = GRN_MAXV; e->seg = 0;
	LOOP {
		int32_t w = grn_write(n, b, L, in[0][i]);
		n->s[4] += 1.f;
		int beat = clocked ? edge(in[1][i], &n->s[3]) : n->s[4] >= 0.25f * SR;
		if (beat) {
			if (n->s[4] > 32.f && n->s[4] < 4.f * SR) n->s[5] = n->s[5] > 0.f ? 0.5f * (n->s[5] + n->s[4]) : n->s[4];
			if (!clocked) n->s[5] = 0.25f * SR;
			n->s[4] = 0.f;
			int nb = (int)n->s[9];
			for (int k = GRN_BEATS - 1; k > 0; k--) log[k] = log[k - 1];
			log[0] = w;
			n->s[9] = (float)(nb < GRN_BEATS ? nb + 1 : GRN_BEATS);
			n->s[6] = (float)burst; n->s[7] = 0.f;
		}
		float beatlen = n->s[5] > 0.f ? n->s[5] : 0.5f * SR;
		float share = beatlen / (float)burst;
		if (n->s[6] > 0.f && n->s[7] <= 0.f) {
			int gi = burst - (int)n->s[6];
			n->s[6] -= 1.f; n->s[7] += share;
			grn_voice *v = grn_take(e);
			if (v) {
				int step = (int)n->s[8] & 7;
				n->s[8] += 1.f;
				float semi = pat == 5 ? (float)GRN_PATTERN[4][scq_rng(&n->rng) & 7] : (float)GRN_PATTERN[pat][step];
				float r = scq_exp2(scq_clamp(pitch + semi / 12.f, -4.f, 3.5f));
				float dd = share * (0.05f + 1.95f * len);
				/* a beat of the log (not the one just heard: what follows it isn't written yet) */
				int have = (int)n->s[9] - 1, pick = 1 + (int)(scq_rand01(&n->rng) * scq_min(slices, (float)(have > 0 ? have : 1)));
				float d;
				if (clocked && have >= 1) {
					if (pick > have) pick = have;
					d = (float)(w - log[pick]);
					if (d < 0.f) d += (float)L;
				} else d = (scq_floor(scq_rand01(&n->rng) * slices) + 1.f) * ((float)L - 16.f) / (slices + 1.f);
				d = grn_fit(d, &dd, r, r, L, 1.f);
				grn_go(v, L, w, d, r, 1.f, dd, 0.f, GRN_EDGE, burst > 1 ? (gi & 1 ? 0.75f : 0.25f) : 0.5f, 1.f);
				v->edge = scq_clamp(0.002f * SR / dd, 0.001f, 0.5f);
			}
		}
		if (n->s[7] > 0.f) n->s[7] -= 1.f;
		grn_render(e, b, L, 0.5f, &n->out[0][i], &n->out[1][i]);
	}
}

/* ------------------------------------------------------------------ time and pitch */

/* stretch — WSOLA (Verhelst and Roelands' waveform-similarity overlap-add): the input is recorded
 * all the time and read back at speed (1 = as it was, 0.1 ten times slower, 0 stands still,
 * negative goes backwards) in 32 ms Hann frames half over each other, every frame placed (to the
 * sub-sample) where it best continues the last one, so a held note stays a clean note. The search
 * is spread over the blocks of a hop. pitch (octaves, -2..+1) reads the frames faster or slower,
 * independent of speed. When the reading falls a tape behind it jumps half a tape on (forwards)
 * or back to now (backwards), and the search makes the jump where the sound continues best. speed
 * 0 or hold stops recording: the tape loops. About 0.1 s late at speed 1. */
typedef struct {
	uint32_t W;            /* samples written, ever */
	int32_t  w;            /* the tape index of the last one */
	float    lag;          /* the analysis point, behind the last sample written */
	uint32_t si;           /* the last frame's start: whole samples (absolute) */
	float    sf;           /*   and the fraction */
	int32_t  have, hop;
	uint32_t tgt, c0;      /* the search: where the last frame would go on, the first candidate */
	float    tf;           /*   (the fraction of where it would go on) */
	int32_t  ncand, done, best, next;
	float    bestf;
	float    bestv, energy;
	float    x1, y1;
} grn_st;
#define GRN_ST_N(sr)  ((float)(int32_t)(0.032f * (sr)))
static uint32_t mem_stretch(float nature) { return grn_mem_tape(scq_max(nature, 2.f)) + (uint32_t)sizeof(grn_st); }

static inline int32_t grn_idx(uint32_t abs, int32_t L) { return (int32_t)(abs % (uint32_t)L); }

static float grn_corr(const int16_t *b, int32_t L, uint32_t x, uint32_t y, int32_t len, int32_t step)
{
	int32_t i = grn_idx(x, L), j = grn_idx(y, L);
	int64_t s = 0;
	if (i + len < L && j + len < L) {                 /* (nearly always: neither runs off the end) */
		const int16_t *x0 = b + i + 1, *y0 = b + j + 1;
		for (int32_t k = 0; k < len; k += step) s += (int32_t)x0[k] * (int32_t)y0[k];
		return (float)(int32_t)(s >> 10);   /* (in range: 384 products of 2^30 at most) */
	}
	for (int32_t k = 0; k < len; k += step) {
		s += (int32_t)b[i + 1] * (int32_t)b[j + 1];
		i += step; if (i >= L) i -= L;
		j += step; if (j >= L) j -= L;
	}
	return (float)(int32_t)(s >> 10);
}

/* the same, Hann-weighted: no ends to pull the peak aside (for placing it between samples) */
static float grn_corrw(const int16_t *b, int32_t L, uint32_t x, uint32_t y, int32_t len)
{
	int32_t i = grn_idx(x, L), j = grn_idx(y, L);
	float s = 0.f, inc = 1.f / (float)len, ph = 0.f;
	for (int32_t k = 0; k < len; k++) {
		s += grn_window(GRN_HANN, ph, 0.f) * (float)b[i + 1] * (float)b[j + 1];
		ph += inc;
		if (++i >= L) i -= L;
		if (++j >= L) j -= L;
	}
	return s;
}

static void run_stretch(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	grn_st *t = (grn_st *)(e + 1);
	int16_t *b = (int16_t *)(t + 1);
	int32_t L = (int32_t)((n->memlen - (uint32_t)sizeof(grn_eng) - (uint32_t)sizeof(grn_st)) / 2u) - 4;
	float speed = scq_clamp(in[1][0], -4.f, 4.f);
	float r = scq_exp2(scq_clamp(in[2][0], -2.f, 1.f));
	int frozen = in[3][0] > 0.5f || scq_abs(speed) < 0.002f;
	const float N = GRN_ST_N(SR);
	const int32_t Hs = (int32_t)(N * 0.5f), T = (int32_t)(N * 0.25f), C = (int32_t)(N * 0.25f);
	const float dmin = (float)(Hs + T + C) + N * scq_max(r, 1.f) + 16.f;
	const float dmax = scq_max((float)L - N - (float)(T + Hs) - 16.f, dmin + N);
	e->nv = 6; e->seg = 0;
	if (t->ncand > 0 && !t->done) {                      /* the search, a share each block */
		int32_t quota = (t->ncand * B) / scq_max(Hs - 2 * B, 1) + 1;
		if (t->next == 0) t->energy = grn_corr(b, L, t->tgt, t->tgt, C, 4) + 1.f;
		while (quota-- > 0 && t->next < t->ncand) {
			int32_t off = 4 * t->next, dist = off - T;
			if (dist < 0) dist = -dist;
			/* alike is best; of the alike (a whole period apart), the nearest to going straight on */
			float v = grn_corr(b, L, t->tgt, t->c0 + (uint32_t)off, C, 4) - t->energy * 0.05f * (float)dist / (float)T;
			if (t->next == 0 || v > t->bestv) { t->bestv = v; t->best = off; }
			t->next++;
		}
		if (t->next >= t->ncand) {                       /* and the last step: sample by sample, then between */
			int32_t b0 = t->best;
			float ym = grn_corrw(b, L, t->tgt, t->c0 + (uint32_t)(b0 - 1), C);
			float y0 = grn_corrw(b, L, t->tgt, t->c0 + (uint32_t)b0, C);
			float yp = grn_corrw(b, L, t->tgt, t->c0 + (uint32_t)(b0 + 1), C);
			for (int k = 0; k < 3 && (ym > y0 || yp > y0); k++) {   /* (walk to the top, up to three steps) */
				if (ym > y0) { t->best--; yp = y0; y0 = ym; ym = grn_corrw(b, L, t->tgt, t->c0 + (uint32_t)(t->best - 1), C); }
				else { t->best++; ym = y0; y0 = yp; yp = grn_corrw(b, L, t->tgt, t->c0 + (uint32_t)(t->best + 1), C); }
			}
			float den = ym - 2.f * y0 + yp;
			t->bestf = den < 0.f ? scq_clamp(0.5f * (ym - yp) / den, -0.5f, 0.5f) : 0.f;
			t->done = 1;
		}
	}
	LOOP {
		float x = grn_dc(in[0][i], &t->x1, &t->y1);
		if (!frozen) {
			t->w = t->w + 1 >= L ? 0 : t->w + 1;
			grn_put(b, L, t->w, x, &n->rng);
			t->W++;
		}
		t->lag += (frozen ? 0.f : 1.f) - speed;
		if (frozen) {                                     /* a loop of the tape */
			if (t->lag < dmin) t->lag += dmax - dmin;
			if (t->lag > dmax) t->lag -= dmax - dmin;
		} else {
			if (t->lag < dmin) t->lag = dmin;
			if (t->lag > dmax) t->lag = speed >= 0.f ? t->lag - 0.5f * (dmax - dmin) : dmin;
		}
		/* a frame every half frame */
		if (++t->hop >= Hs) {
			t->hop = 0;
			uint32_t last = t->W - 1u;
			uint32_t nominal = last - (uint32_t)(int32_t)t->lag;
			if (t->have && t->done) {
				float f = t->tf + t->bestf;
				float fl = scq_floor(f);
				t->si = t->c0 + (uint32_t)t->best + (uint32_t)(int32_t)fl;
				t->sf = f - fl;
			} else { t->si = nominal; t->sf = 0.f; }
			grn_voice *v = grn_take(e);
			float dur = N, d = grn_fit((float)(int32_t)(last - t->si) - t->sf, &dur, r, r, L, frozen ? 0.f : 1.f);
			if (v) grn_go(v, L, t->w, d, r, 1.f, dur, 0.f, GRN_HANN, 0.5f, 1.f);
			t->have = 1;
			/* the search for the next: where this one goes on, against the candidates around where time says */
			float gt = t->sf + (float)Hs * r, gl = scq_floor(gt);
			t->tgt = t->si + (uint32_t)(int32_t)gl; t->tf = gt - gl;
			t->c0 = nominal + (uint32_t)(int32_t)((float)Hs * speed) - (uint32_t)T;
			t->ncand = T / 2 + 1; t->next = 0; t->done = 0; t->best = T; t->bestf = 0.f;
		}
		float l, rr;
		grn_render(e, b, L, 1.f, &l, &rr);
		n->out[0][i] = 0.5f * (l + rr);
	}
}

/* paulstretch — extreme stretch after Paul Nasca's PaulStretch: big windows (2048 or 4096
 * samples, nature 1 or 2) of the tape, every one given random phases and laid half over the next,
 * so time stops being time and the sound becomes its own slow weather. stretch 0..1 is 1x to
 * 1000x; hold stops in place (a held window, breathing). The FFT is spread evenly over the blocks
 * of a hop. When the reading falls a whole tape behind it moves on half a tape (live, the stretch
 * follows what is played, smeared); a silence isn't stretched, it hurries on to now. Wingie weight. */
typedef struct {
	uint32_t W; int32_t w; float lag;
	int32_t N, step, item, opos, cur, loud;
	uint32_t a0;
	float x1, y1;
} grn_ps;
#define GRN_PS_BYTES 61440u
static uint32_t mem_paulstretch(float nature) { (void)nature; return GRN_PS_BYTES; }
static inline float grn_sinq(int32_t k)              /* sin(2 pi k / 8192) */
{
	k &= 8191;
	if (k < 2048) return GRN_SIN[k];
	if (k < 4096) return GRN_SIN[4096 - k];
	if (k < 6144) return -GRN_SIN[k - 4096];
	return -GRN_SIN[8192 - k];
}
static inline float grn_sqrt(float x)
{
	if (!(x > 0.f)) return 0.f;
	union { float f; uint32_t i; } u;
	u.f = x; u.i = 0x1fbd1df5u + (u.i >> 1);
	return scq_sqrt_from(x, u.f);
}
static int32_t grn_log2i(int32_t m) { int32_t s = 0; while ((1 << s) < m) s++; return s; }

#ifndef GRN_PS_W_IN
#define GRN_PS_W_IN   2    /* a window-in item (a tape read with a modulo) */
#endif
#ifndef GRN_PS_W_OUT
#define GRN_PS_W_OUT  8    /* a window-out item (two dithered writes) */
#endif
#ifndef GRN_PS_W_FLY
#define GRN_PS_W_FLY  3    /* a butterfly, in window-items of work */
#endif
#ifndef GRN_PS_W_SPEC
#define GRN_PS_W_SPEC 20   /* a spectrum item */
#endif
/* up to `quota` units of the frame's work; returns 0 when the frame is done */
static int grn_ps_work(grn_ps *p, float *z, int16_t *tape, int32_t L, int16_t *next, int16_t *tail, uint32_t *rng, int32_t quota)
{
	const int32_t N = p->N, M = N / 2, H = N / 2, S = grn_log2i(M);
	const int32_t tN = 8192 / N;
	int32_t st = p->step, it = p->item;
	/* quota is in work, not items: an item of the spectrum stage (two square roots, four table
	 * reads, a random number) costs about ten of the window's. Counting items alike made the
	 * blocks that fell in the spectrum stage several times heavier than the rest (late blocks on
	 * the Wingie at 39 % average). */
	while (quota > 0) {
	quota -= (st == 2 + S) ? GRN_PS_W_SPEC : ((st >= 2 && st < 2 + S) || (st >= 4 + S && st < 4 + 2 * S)) ? GRN_PS_W_FLY
	       : st == 0 ? GRN_PS_W_IN : st == 4 + 2 * S ? GRN_PS_W_OUT : 1;
	if (st == 0) {                                       /* the window in */
		int32_t j = (int32_t)((p->a0 + (uint32_t)it) % (uint32_t)L);
		z[it] = (float)tape[j] * GRN_FROM16 * (0.5f - 0.5f * grn_sinq(it * tN + 2048));
		if (tape[j] > p->loud) p->loud = tape[j];
		if (-tape[j] > p->loud) p->loud = -tape[j];
		if (++it >= N) { st++; it = 0; }
	} else if (st == 1 || st == 3 + S) {                 /* bit reversal */
		int32_t j = 0;
		for (int32_t k = 0; k < S; k++) j |= ((it >> k) & 1) << (S - 1 - k);
		if (it < j) {
			float a = z[2 * it], c = z[2 * it + 1];
			z[2 * it] = z[2 * j]; z[2 * it + 1] = z[2 * j + 1];
			z[2 * j] = a; z[2 * j + 1] = c;
		}
		if (++it >= M) { st++; it = 0; }
	} else if ((st >= 2 && st < 2 + S) || (st >= 4 + S && st < 4 + 2 * S)) {   /* a butterfly */
		int inv = st >= 4 + S;
		int32_t s = st - (inv ? 4 + S : 2), half = 1 << s, len = half << 1;
		int32_t a = ((it >> s) * len) + (it & (half - 1)), c = a + half;
		int32_t k = (it & (half - 1)) * (8192 / len);
		float wr = grn_sinq(k + 2048), wi = inv ? grn_sinq(k) : -grn_sinq(k);
		float xr = z[2 * c] * wr - z[2 * c + 1] * wi, xi = z[2 * c] * wi + z[2 * c + 1] * wr;
		z[2 * c] = z[2 * a] - xr; z[2 * c + 1] = z[2 * a + 1] - xi;
		z[2 * a] += xr; z[2 * a + 1] += xi;
		if (++it >= M / 2) { st++; it = 0; }
	} else if (st == 2 + S) {                            /* the spectrum: magnitudes, new phases */
		int32_t k = it, m = (M - k) & (M - 1);
		if (k == 0) { z[0] = 0.f; z[1] = 0.f; }
		else {
			float zr = z[2 * k], zi = z[2 * k + 1], mr = z[2 * m], mi = z[2 * m + 1];
			/* X[k] = (Z[k] + conj Z[m]) / 2 - i W^k (Z[k] - conj Z[m]) / 2, and the same for m */
			float wkr = grn_sinq(k * tN + 2048), wki = -grn_sinq(k * tN);
			float er = 0.5f * (zr + mr), ei = 0.5f * (zi - mi), dr = 0.5f * (zr - mr), di = 0.5f * (zi + mi);
			float tr = wkr * dr - wki * di, ti = wkr * di + wki * dr;          /* W^k (Z[k] - conj Z[m]) / 2 */
			float xkr = er + ti, xki = ei - tr;
			/* for m: W^m = -conj W^k */
			float er2 = 0.5f * (mr + zr), ei2 = 0.5f * (mi - zi), dr2 = 0.5f * (mr - zr), di2 = 0.5f * (mi + zi);
			float wmr = -wkr, wmi = wki;
			float tr2 = wmr * dr2 - wmi * di2, ti2 = wmr * di2 + wmi * dr2;
			float xmr = er2 + ti2, xmi = ei2 - tr2;
			float ak = grn_sqrt(xkr * xkr + xki * xki), am = grn_sqrt(xmr * xmr + xmi * xmi);
			uint32_t ra = scq_rng(rng);
			int32_t pa = (int32_t)(ra & 8191u), pb = (int32_t)((ra >> 13) & 8191u);
			float ykr = ak * grn_sinq(pa + 2048), yki = ak * grn_sinq(pa);
			float ymr = am * grn_sinq(pb + 2048), ymi = am * grn_sinq(pb);
			if (m == k) { ymr = ykr; ymi = yki; }
			/* Z'[k] = (Y[k] + conj Y[m]) + i W^-k (Y[k] - conj Y[m]); halves dropped (the scale is at the end) */
			float sr = ykr + ymr, si = yki - ymi, ur = ykr - ymr, ui = yki + ymi;
			float vr = wkr * ur + wki * ui, vi = wkr * ui - wki * ur;          /* conj(W^k) u */
			z[2 * k] = sr - vi; z[2 * k + 1] = si + vr;
			if (m != k) {
				float sr2 = ymr + ykr, si2 = ymi - yki, ur2 = ymr - ykr, ui2 = ymi + yki;
				float vr2 = wmr * ur2 + wmi * ui2, vi2 = wmr * ui2 - wmi * ur2;
				z[2 * m] = sr2 - vi2; z[2 * m + 1] = si2 + vr2;
			}
		}
		if (++it > M / 2) { st++; it = 0; }
	} else if (st == 4 + 2 * S) {                        /* the window out, laid over the last */
		const int32_t tw = 8192 / (2 * N);
		const float scale = 1.6329932f / (float)N;          /* sqrt(8/3) for the windows, 1/N for the transforms */
		float a = z[it] * grn_sinq(it * tw) * scale, c = z[H + it] * grn_sinq((H + it) * tw) * scale;
		next[it] = grn_q16((float)tail[it] * GRN_FROM16 + a, rng);
		tail[it] = grn_q16(c, rng);
		if (++it >= H) { st++; it = 0; }
	} else { p->step = st; p->item = it; return 0; }
	}
	p->step = st; p->item = it;
	return 1;
}

static void run_paulstretch(node *n, const float *const in[MAX_IN])
{
	grn_ps *p = (grn_ps *)n->mem;
	if (p->N == 0) { p->N = n->nature < 1.5f ? 2048 : 4096; p->step = 99; p->cur = 0; }
	const int32_t N = p->N, H = N / 2, M = N / 2, S = grn_log2i(M);
	float *z = (float *)(p + 1);
	int16_t *st = (int16_t *)(z + N);                     /* three halves: playing, next, tail */
	int16_t *tape = st + 3 * H;
	int32_t L = (int32_t)((n->memlen - (uint32_t)sizeof(grn_ps) - (uint32_t)N * 4u - 3u * (uint32_t)H * 2u) / 2u);
	int16_t *play = st + p->cur * H, *next = st + (1 - p->cur) * H, *tail = st + 2 * H;
	float factor = scq_exp2(scq_clamp(in[1][0], 0.f, 1.f) * 9.966f);
	int hold = in[2][0] > 0.5f;
	const float dmax = (float)(L - N - 8);
	const int32_t total = N * GRN_PS_W_IN + M + S * (M / 2) * GRN_PS_W_FLY + (M / 2 + 1) * GRN_PS_W_SPEC + M + S * (M / 2) * GRN_PS_W_FLY + H * GRN_PS_W_OUT;
	int32_t quota = total / scq_max((H - 2 * B) / B, 1) + 2;
	grn_ps_work(p, z, tape, L, next, tail, &n->rng, quota);
	LOOP {
		float x = grn_dc(in[0][i], &p->x1, &p->y1);
		if (!hold) {
			p->w = p->w + 1 >= L ? 0 : p->w + 1;
			tape[p->w] = grn_q16(x, &n->rng);
			p->W++;
			p->lag += 1.f - 1.f / factor;
			if (p->lag > dmax) p->lag = 0.5f * dmax;           /* a tape behind: on by half a tape (the windows smooth the step) */
		}
		if (p->lag < 1.f) p->lag = 1.f;
		n->out[0][i] = (float)play[p->opos] * GRN_FROM16;
		if (++p->opos >= H) {                              /* the hop is over: the next frame plays, start one more */
			grn_ps_work(p, z, tape, L, next, tail, &n->rng, 1 << 30);   /* (a frame not yet done: finish it now) */
			if (p->step != 99) p->cur = 1 - p->cur;          /* (99: nothing was being made, at the very start) */
			play = st + p->cur * H; next = st + (1 - p->cur) * H;
			p->opos = 0;
			if (!hold && p->step != 99 && p->loud < 4) { p->lag *= 0.5f; if (p->lag < 1.f) p->lag = 1.f; }   /* stretching a silence: hurry on towards now */
			p->loud = 0;
			p->a0 =p->W - 1u - (uint32_t)(int32_t)p->lag - (uint32_t)N;
			p->step = 0; p->item = 0;
		}
	}
}

/* psola — pitch-synchronous overlap-add (Moulines and Charpentier's TD-PSOLA): the period of what
 * comes in is tracked (YIN, on an 8 kHz copy, a share each block), and two-period grains cut on
 * its peaks are laid down at the new period: pitch moves (octaves), the formants stay, a voice
 * stays a voice. formant (octaves) squeezes or stretches each grain to move them on purpose.
 * period gives the tracked pitch in octaves from middle C. Unpitched sound passes as 10 ms grains. */
#define GRN_PS_DEC 1024
#define GRN_PS_WIN 256
#define GRN_PS_TAU 256
typedef struct {
	float    x1, y1, bq[4], c[5];
	float    dec[GRN_PS_DEC];
	uint32_t dn;                 /* decimated samples, ever */
	int32_t  dphase, D;
	float    d[GRN_PS_TAU + 1];
	uint32_t a0;                 /* the analysis window's start (decimated) */
	int32_t  tau, tmin, tmax;
	float    period, voiced, lagc, cnt;
	int32_t  hop;
} grn_pso;
#define GRN_PSO_L 8192
static uint32_t mem_psola(float nature) { (void)nature; return (uint32_t)sizeof(grn_eng) + (uint32_t)sizeof(grn_pso) + (GRN_PSO_L + 4) * 2u; }
static void grn_yin_end(grn_pso *p)
{
	float sum = 0.f, best = 1e9f;
	int32_t bt = -1;
	for (int32_t t = 1; t <= p->tmax; t++) {
		sum += p->d[t];
		float dn = sum > 0.f ? p->d[t] * (float)t / sum : 1.f;
		if (t < p->tmin) continue;
		if (dn < 0.15f) {                                  /* the first dip under the threshold: walk to its bottom */
			float prevn = dn;
			int32_t tt = t;
			float s2 = sum;
			while (tt < p->tmax) {
				float n2 = p->d[tt + 1] * (float)(tt + 1) / (s2 + p->d[tt + 1]);
				if (n2 >= prevn) break;
				s2 += p->d[tt + 1]; prevn = n2; tt++;
			}
			bt = tt; best = prevn;
			break;
		}
		if (dn < best) { best = dn; bt = t; }
	}
	if (bt < 0 || best > 0.35f) { p->voiced = 0.f; return; }
	float tau = (float)bt;
	if (bt > 1 && bt < p->tmax) {                          /* parabolic between the neighbours */
		float a = p->d[bt - 1], b0 = p->d[bt], c = p->d[bt + 1], den = a - 2.f * b0 + c;
		if (den > 1e-12f) tau += scq_clamp(0.5f * (a - c) / den, -0.5f, 0.5f);
	}
	p->period = tau * (float)p->D;
	p->voiced = 1.f;
}
static void run_psola(node *n, const float *const in[MAX_IN])
{
	grn_eng *e = (grn_eng *)n->mem;
	grn_pso *p = (grn_pso *)(e + 1);
	int16_t *b = (int16_t *)(p + 1);
	const int32_t L = GRN_PSO_L;
	float ratio = scq_exp2(scq_clamp(in[1][0], -2.f, 2.f)), fr = scq_exp2(scq_clamp(in[2][0], -1.f, 1.f));
	e->nv = GRN_MAXV / 2; e->seg = 0;
	/* the decimation (SR / D near 8 kHz) and its lowpass: two Butterworth biquads at 0.2 of the low rate */
	int32_t D = (int32_t)(SR / 12000.f + 0.5f);
	if (D < 1) D = 1;
	if (D != p->D) { p->D = D; p->dphase = 0; }
	const float srd = SR / (float)D;
	p->tmin = (int32_t)(srd / 1000.f); p->tmax = (int32_t)(srd / 60.f);
	if (p->tmin < 2) p->tmin = 2;
	if (p->tmax > GRN_PS_TAU - 1) p->tmax = GRN_PS_TAU - 1;
	float bc[2][5];
	{
		float f = 0.2f * srd * INV_SR, cs = scq_sin2pi(f + 0.25f), sn = scq_sin2pi(f);
		static const float Q[2] = { 0.5412f, 1.3066f };
		for (int k = 0; k < 2; k++) {
			float al = sn / (2.f * Q[k]), a0 = 1.f + al;
			bc[k][0] = 0.5f * (1.f - cs) / a0; bc[k][1] = (1.f - cs) / a0; bc[k][2] = bc[k][0];
			bc[k][3] = -2.f * cs / a0; bc[k][4] = (1.f - al) / a0;
		}
	}
	/* YIN's difference function, a share of the lags each block */
	if (p->tau >= 1 && p->tau <= p->tmax) {
		int32_t quota = (p->tmax * B) / 400 + 1;
		while (quota-- > 0 && p->tau <= p->tmax) {
			float s = 0.f;
			uint32_t a = p->a0, c = p->a0 + (uint32_t)p->tau;
			for (int32_t j = 0; j < GRN_PS_WIN; j++) {
				float df = p->dec[(a + (uint32_t)j) & (GRN_PS_DEC - 1)] - p->dec[(c + (uint32_t)j) & (GRN_PS_DEC - 1)];
				s += df * df;
			}
			p->d[p->tau++] = s;
		}
		if (p->tau > p->tmax) grn_yin_end(p);
	}
	float P = p->voiced > 0.f ? scq_clamp(p->period, SR / 1000.f, SR / 60.f) : 0.01f * SR;
	LOOP {
		float x = grn_dc(in[0][i], &p->x1, &p->y1);
		/* the tape */
		int32_t w = (int32_t)p->c[0] + 1;
		if (w >= L || w < 0) w = 0;
		grn_put(b, L, w, x, &n->rng);
		p->c[0] = (float)w;
		p->lagc += 1.f;
		/* the 8 kHz copy */
		float y = x;
		for (int k = 0; k < 2; k++) {
			float o = bc[k][0] * y + p->bq[2 * k];
			p->bq[2 * k] = bc[k][1] * y - bc[k][3] * o + p->bq[2 * k + 1];
			p->bq[2 * k + 1] = bc[k][2] * y - bc[k][4] * o;
			if (scq_abs(p->bq[2 * k]) < 1e-15f) p->bq[2 * k] = 0.f;
			if (scq_abs(p->bq[2 * k + 1]) < 1e-15f) p->bq[2 * k + 1] = 0.f;
			y = o;
		}
		if (++p->dphase >= D) {
			p->dphase = 0;
			p->dec[p->dn & (GRN_PS_DEC - 1)] = y;
			p->dn++;
			if (++p->hop >= 512 / D + 1 && p->tau > p->tmax) {   /* a new estimate every ~11 ms */
				p->hop = 0;
				p->a0 = p->dn - (uint32_t)(GRN_PS_WIN + p->tmax);
				p->tau = 1;
			}
		}
		if (p->tau == 0) p->tau = p->tmax + 1;            /* (the first block: let the clock above start one) */
		/* a grain at every output period */
		p->cnt -= 1.f;
		while (p->cnt <= 0.f) {
			float t0 = -p->cnt;
			p->cnt += P / ratio;
			grn_voice *v = grn_take(e);
			float d0 = 2.f * P + 64.f;
			if (p->voiced > 0.f) {
				float k = scq_floor((p->lagc - d0) / P + 0.5f);
				p->lagc -= k * P;
				if (p->lagc < P + 8.f || p->lagc > (float)L - 3.f * P - 16.f) p->lagc = d0;
				/* onto the nearest peak, within an eighth of a period */
				int32_t lc = (int32_t)p->lagc, best = lc, rad = (int32_t)(P * 0.125f);
				float bv = -2.f;
				for (int32_t q = lc - rad; q <= lc + rad; q++) {
					int32_t j = w - q; if (j < 0) j += L;
					float s = (float)b[j + 1];
					if (s > bv) { bv = s; best = q; }
				}
				{                                           /* to a fraction, and only a step of the way: the marks keep their spacing */
					int32_t j0 = w - best; if (j0 < 0) j0 += L;
					int32_t jm = j0 + 1 >= L ? 0 : j0 + 1, jp = j0 - 1 < 0 ? L - 1 : j0 - 1;   /* (lag - 1 is a sample later) */
					float ym = (float)b[jm + 1], y0 = (float)b[j0 + 1], yp = (float)b[jp + 1], den = ym - 2.f * y0 + yp;
					float pk = (float)best + (den < 0.f ? scq_clamp(0.5f * (ym - yp) / den, -0.5f, 0.5f) : 0.f);
					p->lagc += 0.15f * (pk - p->lagc);
				}
			} else p->lagc = d0 + P * scq_rand01(&n->rng);
			if (!v) continue;
			grn_go(v, L, w, p->lagc + P - t0, fr, 1.f, 2.f * P / fr, t0, GRN_HANN, 0.5f, 1.f);   /* (the delay at the onset itself) */
		}
		float l, rr;
		grn_render(e, b, L, 0.f, &l, &rr);   /* (grains a period apart add as power: a higher voice is a little louder, as it is) */
		n->out[0][i] = 0.5f * (l + rr);
		n->out[1][i] = grn_log2(SR / P * (1.f / 261.6256f));
	}
}

/* wavesets — Trevor Wishart's waveset distortion (Composers' Desktop Project): what comes in is cut
 * at its rising zero crossings (to the fraction of a sample, so the pieces join without a step)
 * into wavesets, and they are played back changed by mode=: repeat (each one 1 - 8 times: amount),
 * omit (each dropped by chance: amount), reverse (each played backwards by chance), shuffle (each
 * swapped for one of the last 2 - 16), substitute (each replaced by a sine of its length and
 * height, amount of the way), average (groups of 1 - 8 averaged into one shape, played as many
 * times). Joins stay at zero, so nothing clicks unless the sound asks for it. */
#define GRN_WS_RING 8192
#define GRN_WS_Q    64
typedef struct { uint32_t start; float frac, len, peak; } grn_wset;
typedef struct {
	float    ring[GRN_WS_RING];
	grn_wset q[GRN_WS_Q];
	uint32_t W, qn, lastc, k;
	float    lastf, peak, prev, x1, y1;
	float    tau, plen;       /* the one playing: time into it, its length as played */
	int32_t  kind, rep, nrep, grp, playing;
	uint32_t pick;
} grn_wv;
static uint32_t mem_wavesets(float nature) { (void)nature; return (uint32_t)sizeof(grn_wv); }
static inline float grn_ring_read(const float *r, uint32_t at, float f)
{
	return grn_hermite(r[(at - 1u) & (GRN_WS_RING - 1)], r[at & (GRN_WS_RING - 1)], r[(at + 1u) & (GRN_WS_RING - 1)], r[(at + 2u) & (GRN_WS_RING - 1)], f);
}
static inline float grn_ws_at(const grn_wv *v, const grn_wset *s, float t)    /* t samples into waveset s */
{
	float p = s->frac + scq_clamp(t, 0.f, s->len);
	float fl = scq_floor(p);
	return grn_ring_read(v->ring, s->start + (uint32_t)(int32_t)fl, p - fl);
}
static void run_wavesets(node *n, const float *const in[MAX_IN])
{
	grn_wv *v = (grn_wv *)n->mem;
	float amount = scq_clamp(in[1][0], 0.f, 1.f);
	int mode = (int)scq_clamp(n->opt[0], 0.f, 5.f);
	const float minlen = SR / 3000.f, maxlen = 2048.f;
	LOOP {
		/* cut */
		float x = grn_dc(in[0][i], &v->x1, &v->y1);
		v->ring[v->W & (GRN_WS_RING - 1)] = x;
		v->W++;
		if (scq_abs(x) > v->peak) v->peak = scq_abs(x);
		float since = (float)(v->W - 2u - v->lastc) - v->lastf;
		int cut = 0; float cf = 0.f;
		if (v->prev < 0.f && x >= 0.f) { cf = v->prev / (v->prev - x); if (since + cf >= minlen) cut = 1; }
		if (!cut && since > maxlen) { cut = 1; cf = 0.f; }
		if (cut) {
			grn_wset *s = &v->q[v->qn & (GRN_WS_Q - 1)];
			s->start = v->lastc; s->frac = v->lastf; s->len = since + cf; s->peak = v->peak;
			v->qn++;
			v->lastc = v->W - 2u; v->lastf = cf; v->peak = 0.f;
		}
		v->prev = x;
		/* play */
		if (!v->playing) {
			if (v->qn >= 2) { v->playing = 1; v->k = v->qn - 1; v->rep = 0; v->nrep = 0; v->tau = 0.f; v->plen = 0.f; }
			n->out[0][i] = 0.f;
			continue;
		}
		if (v->tau >= v->plen) {                          /* the next waveset: what to do with it */
			v->tau -= v->plen;
			if (v->rep + 1 < v->nrep) v->rep++;
			else {
				v->k += (uint32_t)(v->grp > 0 ? v->grp : 1);
				v->rep = 0;
				if (v->qn - v->k > 24u) v->k = v->qn - 2u;          /* fallen behind: catch up */
				if ((int32_t)(v->qn - v->k) <= 0) v->k = v->qn - 1u; /* nothing new: the last again */
				if (v->W - v->q[v->k & (GRN_WS_Q - 1)].start > GRN_WS_RING - 4200u) v->k = v->qn - 1u;   /* (written over) */
				grn_wset *s = &v->q[v->k & (GRN_WS_Q - 1)];
				v->nrep = 1; v->grp = 1; v->kind = 0; v->pick = v->k;
				switch (mode) {
				case 0: v->nrep = 1 + (int32_t)(amount * 7.f + 0.5f); break;
				case 1: v->kind = scq_rand01(&n->rng) < amount ? 2 : 0; break;
				case 2: v->kind = scq_rand01(&n->rng) < amount ? 1 : 0; break;
				case 3: {
					uint32_t m = 2u + (uint32_t)(amount * 14.f), back = scq_rng(&n->rng) % m;
					if (back >= v->qn) back = 0;
					v->pick = v->qn - 1u - back;
					if (v->W - v->q[v->pick & (GRN_WS_Q - 1)].start > GRN_WS_RING - 2200u) v->pick = v->k;
					break; }
				case 4: v->kind = 3; break;
				default: {
					int32_t g = 1 + (int32_t)(amount * 7.f + 0.5f), have = (int32_t)(v->qn - v->k);
					if (g > have) g = have;
					if (g < 1) g = 1;
					v->grp = g; v->nrep = g; v->kind = g > 1 ? 4 : 0;
					break; }
				}
				if (v->kind == 4) {
					float sl = 0.f;
					for (int32_t j = 0; j < v->grp; j++) sl += v->q[(v->k + (uint32_t)j) & (GRN_WS_Q - 1)].len;
					v->plen = sl / (float)v->grp;
				} else v->plen = v->q[v->pick & (GRN_WS_Q - 1)].len;
				(void)s;
			}
			if (v->plen < 1.f) v->plen = 1.f;
		}
		const grn_wset *s = &v->q[v->pick & (GRN_WS_Q - 1)];
		float y;
		switch (v->kind) {
		case 1: y = grn_ws_at(v, s, s->len - v->tau); break;
		case 2: y = 0.f; break;
		case 3: y = (1.f - amount) * grn_ws_at(v, s, v->tau) + amount * s->peak * scq_sin2pi(v->tau / v->plen); break;
		case 4: {
			float sum = 0.f;
			for (int32_t j = 0; j < v->grp; j++) {
				const grn_wset *g = &v->q[(v->k + (uint32_t)j) & (GRN_WS_Q - 1)];
				sum += grn_ws_at(v, g, v->tau * g->len / v->plen);
			}
			y = sum / (float)v->grp;
			break; }
		default: y = grn_ws_at(v, s, v->tau);
		}
		v->tau += 1.f;
		n->out[0][i] = y;
	}
}

/* ------------------------------------------------------------------ grains as sources */

/* trainlet — Roads' trainlets with Rodet's FOF grains: at every period of pitch (nature x 60 Hz)
 * a formant grain is born, a sine at formant (200 Hz .. 4 kHz) with a smooth 2 ms attack, dying
 * away at bandwidth (20 Hz .. 1 kHz wide: narrow rings, wide buzzes). Below full density the
 * pulse train comes in trainlets, bursts of 40 - 250 ms at random times, each a little off pitch.
 * chroma= (0 - 100) adds the formant's own harmonics, kept below the Nyquist. Each grain is a
 * damped phasor, exact, born to the sub-sample. */
#define GRN_FOF 16
typedef struct { float c, s, kc, ks, att, ainc, amp; int32_t on; } grn_fof;
typedef struct {
	grn_fof  f[GRN_FOF];
	float    ph, gate, gph, ginc, gcnt, gpitch, x1, y1;
} grn_tr;
static uint32_t mem_trainlet(float nature) { (void)nature; return (uint32_t)sizeof(grn_tr); }
static void run_trainlet(node *n, const float *const in[MAX_IN])
{
	grn_tr *t = (grn_tr *)n->mem;
	float f0 = 60.f * scq_clamp(n->nature, 0.05f, 40.f) * scq_exp2(scq_clamp(in[0][0], -8.f, 6.f));
	float fc = scq_min(200.f * scq_exp2(scq_clamp(in[1][0], 0.f, 1.f) * 4.322f), 0.45f * SR);
	float dens = scq_clamp(in[2][0], 0.f, 1.f);
	f0 = scq_clamp(f0, 1.f, 0.25f * SR);
	float bw = scq_max(20.f * scq_exp2(scq_clamp(in[3][0], 0.f, 1.f) * 5.644f), 0.15f * f0);
	float dec = scq_exp2(-SCQ_PI * bw * INV_SR * 1.442695f);
	float th = fc * INV_SR, kc = scq_sin2pi(th + 0.25f) * dec, ks = scq_sin2pi(th) * dec;
	float chroma = scq_clamp(n->opt[0] * 0.01f, 0.f, 1.f) * 0.9f;
	float amax = scq_exp2(-9.97f * 2.f * fc * INV_SR);        /* harmonics of fc gone by the Nyquist */
	float a = scq_min(chroma, amax), a2 = 1.f + a * a;
	float norm = (1.f - scq_exp2(-SCQ_PI * bw / f0 * 1.442695f)) * (1.f - a) * 0.8f;
	float ainc = 1.f / (0.002f * SR);
	int cont = dens >= 0.98f;
	float grate = 0.5f * scq_exp2(dens * 5.3f);             /* trainlets a second */
	LOOP {
		/* the trainlet gate */
		float gv = 1.f, pf = 1.f;
		if (!cont) {
			if (t->ginc == 0.f) {
				t->gcnt = scq_min(t->gcnt, 8.f * SR / grate) - 1.f;   /* no wait longer than the rate now could draw */
				if (t->gcnt <= 0.f) {
					t->ginc = 1.f / ((0.04f + 0.21f * scq_rand01(&n->rng)) * SR);
					t->gph = 0.f;
					t->gpitch = scq_exp2(0.1f * scq_noise(&n->rng));
					t->gcnt = SR / grate * grn_expo(&n->rng);
				}
				gv = 0.f;
			} else {
				gv = grn_window(GRN_HANN, t->gph, 0.f);
				t->gph += t->ginc;
				if (t->gph >= 1.f) t->ginc = 0.f;
			}
			pf = t->gpitch > 0.f ? t->gpitch : 1.f;
		}
		/* the pulse train: a FOF at every period */
		t->ph += f0 * pf * INV_SR;
		if (t->ph >= 1.f) {
			t->ph -= scq_floor(t->ph);
			float frac = t->ph / (f0 * pf * INV_SR);             /* how long ago it was due */
			if (gv > 0.001f) {
				int k = 0, best = 0;
				float low = 1e9f;
				for (; k < GRN_FOF; k++) {
					if (!t->f[k].on) { best = k; break; }
					float m = t->f[k].c * t->f[k].c + t->f[k].s * t->f[k].s;
					if (m < low) { low = m; best = k; }
				}
				grn_fof *g = &t->f[best];
				float p0 = th * frac;
				float d0 = scq_exp2(-SCQ_PI * bw * INV_SR * 1.442695f * frac);
				g->c = d0 * scq_sin2pi(p0 + 0.25f); g->s = d0 * scq_sin2pi(p0);
				g->att = frac * ainc; g->ainc = ainc; g->amp = gv; g->on = 1;
			}
		}
		float sum = 0.f;
		for (int k = 0; k < GRN_FOF; k++) {
			grn_fof *g = &t->f[k];
			if (!g->on) continue;
			float env = 1.f;
			if (g->att < 1.f) { float x = g->att; env = x * x * (3.f - 2.f * x); g->att += g->ainc; }
			float s = g->s;
			if (a > 0.f) s = s / (a2 - 2.f * a * g->c);   /* (sum of a^(k-1) sin k theta, decaying with the grain) */
			sum += s * env * g->amp;
			float c2 = g->c * kc - g->s * ks, s2 = g->c * ks + g->s * kc;
			g->c = c2; g->s = s2;
			if (g->c * g->c + g->s * g->s < 1e-7f) g->on = 0;
		}
		n->out[0][i] = grn_lim(grn_dc(sum * norm, &t->x1, &t->y1));
	}
}

/* gendy — Xenakis's GENDY (dynamic stochastic synthesis, 1991): a wave of 12 breakpoints, each one's
 * height and length taking a random walk every time round, steps drawn from dist= and kept
 * between mirrors. amp_step is how far the heights wander, dur_step how far the lengths (and so
 * the pitch, around nature x 60 Hz) do. Drawn at twice the rate and brought down through the
 * half-band, so the corners don't fold back. */
#define GRN_GN 12
typedef struct {
	float   amp[GRN_GN], dur[GRN_GN], va[GRN_GN], vd[GRN_GN];
	float   t, x1, y1;
	int32_t j;
	grn_hb  hb;
} grn_gd;
static uint32_t mem_gendy(float nature) { (void)nature; return (uint32_t)sizeof(grn_gd); }
static inline float grn_mirror(float x, float lo, float hi)
{
	for (int k = 0; k < 4 && (x < lo || x > hi); k++) {
		if (x > hi) x = 2.f * hi - x;
		if (x < lo) x = 2.f * lo - x;
	}
	return scq_clamp(x, lo, hi);
}
static float grn_gendy_dist(int kind, uint32_t *rng)
{
	float u = scq_clamp(scq_rand01(rng), 0.001f, 0.999f), x;
	switch (kind) {
	case 1: x = 0.3f * 0.693147f * grn_log2(u / (1.f - u)); break;                     /* logistic */
	case 2: { float a = 0.25f * u;                                                      /* hyperbolic cosine: ln tan(pi u / 2) */
		x = 0.25f * 0.693147f * grn_log2(scq_max(scq_sin2pi(a) / scq_max(scq_sin2pi(a + 0.25f), 1e-4f), 1e-6f)); break; }
	case 3: x = scq_sin2pi(0.5f * (u - 0.5f)); break;                                    /* arcsine */
	case 4: x = -0.25f * 0.693147f * grn_log2(u) * (scq_rand01(rng) < 0.5f ? -1.f : 1.f); break;   /* exponential */
	default: { float a = 0.5f * (u - 0.5f);                                              /* cauchy */
		x = 0.1f * scq_sin2pi(a) / scq_max(scq_sin2pi(a + 0.25f), 1e-3f); }
	}
	return scq_clamp(x, -1.f, 1.f);
}
static void run_gendy(node *n, const float *const in[MAX_IN])
{
	grn_gd *g = (grn_gd *)n->mem;
	float f0 = scq_clamp(60.f * scq_clamp(n->nature, 0.05f, 40.f) * scq_exp2(scq_clamp(in[0][0], -8.f, 6.f)), 0.5f, 0.2f * SR);
	float as = scq_clamp(in[1][0], 0.f, 1.f), ds = scq_clamp(in[2][0], 0.f, 1.f);
	int kind = (int)scq_clamp(n->opt[0], 0.f, 4.f);
	if (g->dur[0] == 0.f)
		for (int k = 0; k < GRN_GN; k++) { g->dur[k] = 1.f; g->amp[k] = scq_noise(&n->rng) * 0.5f; }
	/* half-steps: a segment of weight d lasts d / (12 f0) seconds */
	float per = 2.f * SR / (f0 * (float)GRN_GN);
	float lo = 1.f - 0.9f * ds, hi = 1.f + 3.f * ds;
	LOOP {
		float v[2];
		for (int h = 0; h < 2; h++) {
			int32_t j = g->j, j1 = j + 1 >= GRN_GN ? 0 : j + 1;
			float len = scq_max(g->dur[j] * per, 1.f);
			if (g->t >= len) {                              /* the next breakpoint: walk the one after it */
				g->t -= len;
				g->j = j = j1; j1 = j + 1 >= GRN_GN ? 0 : j + 1;
				g->va[j1] = grn_mirror(g->va[j1] + 0.3f * as * grn_gendy_dist(kind, &n->rng), -0.3f * as, 0.3f * as);
				g->amp[j1] = grn_mirror(g->amp[j1] + g->va[j1], -1.f, 1.f);
				g->vd[j1] = grn_mirror(g->vd[j1] + 0.3f * ds * grn_gendy_dist(kind, &n->rng), -0.3f * ds, 0.3f * ds);
				g->dur[j1] = grn_mirror(g->dur[j1] + g->vd[j1], lo, hi);
				len = scq_max(g->dur[j] * per, 1.f);
				if (g->t >= len) g->t = 0.f;
			}
			float x = g->t / len;
			v[h] = g->amp[j] + (g->amp[j1] - g->amp[j]) * x;
			g->t += 1.f;
		}
		float l, r;
		grn_hb_push(&g->hb, v[0], v[1], 0.f, 0.f, 0.f, 0.f, &l, &r);
		n->out[0][i] = grn_dc(l, &g->x1, &g->y1);
	}
}
