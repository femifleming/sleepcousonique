/* scq_proc_grain: P(...) table lines (hi-fi granular; the code and its notes are in scq_proc_grain.inc).
 * A tape's nature is its length in tenths of a second, 16-bit (6: 0.6 s, 58 KB); samplerate=half
 * doubles the seconds in the same memory. */
P("grains",  FAM_SPACE, 0, 650, 6, "in position spray size density pitch spread freeze", "0 0 0.1 0.5 0.5 0 0.5 0", "left right", run_grains, 0, grn_mem_tape,
  "a field of glass beads catching the room: the hi-fi granulator of what comes in (after Roads, Truax, Granulator II). position 0 now .. 1 the tape's end, spray scatters further back, size 4 ms .. 1 s, density a quarter to 24 grains deep (the level holds), pitch in octaves, spread the stereo width, freeze holds the tape; window=, sync= (a grid or Poisson), reverse= % of grains backwards. Tape: nature tenths of a second (6: 0.6 s, 58 KB; samplerate=half doubles it). Hermite reads, pitched-up grains read at 2x through a half-band, so an octave up doesn't alias; for the Wingie when dense"),
P("stretch", FAM_SPACE, 0, 700, 6, "in speed pitch hold", "0 0.25 0 0", "out", run_stretch, 0, mem_stretch,
  "a slow-motion replay of the evening: WSOLA time-stretch of what comes in (after Verhelst's waveform-similarity overlap-add). speed 1 as it was, 0.1 ten times slower, 0 stands still, negative backwards; pitch in octaves (-2..+1) on its own; a held note stays a clean note. A tape behind it jumps on, where the search finds the sound goes on best; speed 0 or hold stops recording and loops. Tape: nature tenths of a second (6: 0.6 s; samplerate=half doubles it), about 0.1 s late; for the Wingie"),
P("paulstretch", FAM_SPACE, 0, 1450, 2, "in stretch hold", "0 0.5 0", "out", run_paulstretch, 0, mem_paulstretch,
  "one minute becomes one hour, a glacier: extreme spectral stretch (after Paul Nasca's PaulStretch). Windows of 2048 (nature 1) or 4096 samples (nature 2) given random phases, half over the next; stretch 0..1 is 1x to 1000x, hold stops time and lets the window breathe. The FFT is spread evenly over the blocks. 60 KB, a 0.3-0.5 s tape (samplerate=half doubles it and the window). Wingie weight"),
P("psola",   FAM_SPACE, 0, 2000, 1, "in pitch formant", "0 0 0", "out period", run_psola, 0, mem_psola,
  "a choir boy grown up overnight: pitch-synchronous overlap-add (after Moulines and Charpentier's TD-PSOLA). Tracks the period (YIN) and lays two-period grains at the new one: pitch in octaves, the formants stay (a voice stays a voice); formant in octaves moves them on purpose; period is the tracked pitch, octaves from middle C. About two periods late; for the Wingie"),
P("glisson", FAM_SPACE, 0, 1150, 4, "in density size glide spread", "0 0.5 0.4 1 0.3", "left right", run_glisson, 0, grn_mem_tape,
  "swallows diving from the bridge: glissons, grains that glide in pitch as they sound (after Curtis Roads' Microsound). glide is the range in octaves (negative falls), spread how many go the other way, how far their start pitches and stereo places scatter; size 10 ms .. 0.5 s; window=. Tape: nature tenths of a second (4: 0.4 s; samplerate=half doubles it); for the Wingie"),
P("grainfreeze", FAM_SPACE, 0, 1100, 6, "in capture blend drift", "0 0 1 0.2", "left right", run_grainfreeze, 0, mem_grainfreeze,
  "the photograph that breathes: a pulse into capture holds the last moment as a seamless drone of overlapping gauss grains (after Clouds' freeze, done clean); drift wanders where they read and their pitch (up to half a semitone); blend from what comes in (0) to the held moment (1); a capture crossfades in 30 ms. Until the first pulse it captures itself every half tape. Holds half the tape: nature tenths of a second (6: 0.3 s held; samplerate=half doubles it); for the Wingie"),
P("graindelay", FAM_SPACE, 0, 800, 6, "in time jitter pitch feedback density", "0 0.4 0.1 0 0.4 0.5", "left right", run_graindelay, 0, grn_mem_tape,
  "a mirrored corridor that sings back: granular delay (after Portal and the GR-1, but clean). Grains read the line at time (10 ms .. the tape) give or take jitter, pitched in octaves and spread in the stereo, and feed back through themselves (pitch 1 and feedback: shimmer); density 1 - 12 deep. Tape: nature tenths of a second (6: 0.6 s; samplerate=half doubles it); for the Wingie"),
P("scrub",   FAM_SPACE, 0, 700, 6, "in position record smooth", "0 0 0 0.3", "out", run_scrub, 0, grn_mem_tape,
  "a hand on the reel: scrubbing. record (a pulse records at least a quarter of the tape, held keeps recording), then position 0..1 moves the head across it, smoothed by smooth (1 ms .. 1 s); slower than normal the grains keep their pitch, faster it rises like tape, stopped holds a grain loop. Before any recording it scrubs the live tape (1 = now). Tape: nature tenths of a second (6: 0.6 s; samplerate=half doubles it); for the Wingie"),
P("wavesets", FAM_SHAPE, 0, 140, 1, "in amount", "0 0.5", "out", run_wavesets, 0, mem_wavesets,
  "a broken string of pearls rethreaded: Trevor Wishart's waveset distortion (after the Composers' Desktop Project). The sound is cut at its rising zero crossings; mode= repeat (each 1-8 times: amount), omit (by chance), reverse (by chance), shuffle (among the last 2-16), substitute (a sine of the same length, amount of the way), average (groups of 1-8 into one shape). 32 KB"),
P("harmonicgrains", FAM_SPACE, 0, 1550, 3, "in pitch density size", "0 0 0.5 0.4", "left right", run_harmonicgrains, 0, grn_mem_tape,
  "the choir in the empty church: a granular harmoniser, grains of what comes in transposed onto the tones of chord= on pitch (octaves), every tone its own place in the stereo; density 1 - 24 deep, size 20 - 300 ms. Tape: nature tenths of a second (3: 0.3 s; samplerate=half doubles it); for the Wingie"),
P("beatgrains", FAM_SPACE, 0, 500, 6, "in clock slices pitch length", "0 0 0.5 0 0.5", "left right", run_beatgrains, 0, mem_beatgrains,
  "the DJ's hand on the platter: tempo-locked stutters. Every clock pulse fires a grain (or burst= of them across the beat, left and right) starting on one of the last 1-16 beats (slices), pitch stepping by pattern= in semitones, length 5% .. twice its share of the beat; 2 ms edges keep attacks sharp. Unclocked: four a second on slices of the tape. Tape: nature tenths of a second (6: 0.6 s; samplerate=half doubles it)"),
P("granularverb", FAM_SPACE, 0, 1800, 6, "in size density", "0 0.6 0.6", "left right", run_granularverb, 0, grn_mem_tape,
  "a cathedral of sand: a reverb made of grains, dozens of 10-35 ms grains reading a long delay at random times, fed back and gently darkened; size the reach and the decay (0.5 .. 16 s), density 4 - 32 deep. Tape: nature tenths of a second (6: 0.6 s; samplerate=half doubles it); for the Wingie"),
P("trainlet", FAM_SOURCE, PF_DRIFT, 330, 2, "pitch formant density bandwidth", "0 0.4 1 0.3", "out", run_trainlet, 0, mem_trainlet,
  "a voice from the radiator pipes: trainlets of FOF formant grains (after Roads and Rodet's CHANT). At each period of pitch (nature x 60 Hz) a grain at formant (200 Hz .. 4 kHz) rings out over bandwidth (20 Hz .. 1 kHz); under full density the train comes in bursts of 40-250 ms; chroma= 0-100 adds the formant's harmonics (kept under the Nyquist)"),
P("gendy",   FAM_SOURCE, PF_DRIFT, 330, 2, "pitch amp_step dur_step", "0 0.3 0.3", "out", run_gendy, 0, mem_gendy,
  "the electric storm over Mycenae: Iannis Xenakis's GENDY dynamic stochastic synthesis, a wave of 12 breakpoints whose heights and lengths take random walks between mirrors with steps from dist=; amp_step how far heights wander, dur_step how far lengths (and the pitch, around nature x 60 Hz) do. Drawn at 2x and brought down through a half-band, so the corners don't alias"),
P("particles", FAM_SPACE, 0, 500, 4, "in density screen pitch", "0 0.5 0 0", "left right", run_particles, 0, grn_mem_tape,
  "dust in a projector beam: a stochastic cloud after Xenakis's screens, every grain's onset, pitch, length, stereo place and moment drawn from dist=; screen morphs from A (a tight shimmer: unison, 15 ms, near now) to B (two octaves on a Xenakis sieve, 180 ms, half a second back, wide, some reversed); density 2 - 400 a second, pitch the centre in octaves. Tape: nature tenths of a second (4: 0.4 s; samplerate=half doubles it)"),
