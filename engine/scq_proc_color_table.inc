/* scq_proc_color: colour, dynamics, modulation, space and listening (code in scq_proc_color.inc) */
/* ---- colour ---- */
P("fuzz",    FAM_SHAPE, 0, 130, 1, "in drive bias", "0 0.5 0", "out", run_fuzz, 0, 0,
  "germanium fuzz: two hot transistors, asymmetric; bias 0 is the sweet spot, below it the battery dies and the sound splutters and gates, above it one side fattens (after the Arbiter Fuzz Face, the Fuzz Factory)"),
P("chloe",   FAM_SHAPE, PF_DRIFT, 230, 1, "in drive cutoff resonance gate", "0 0.3 0.6 0.3 0", "out", run_chloe, 0, 0,
  "the Chloe module: a vacuum tube driven into its grid, a multimode filter (mode=low|band|high) that sings when pushed, and a low-pass gate struck by gate (open when nothing is in gate)"),
P("tape",    FAM_SHAPE, 0, 200, 1, "in age wow", "0 0.3 0.3", "out", run_tape, 0, mem_tape,
  "the cassette that lived in a car: wow, flutter, the head bump, soft saturation, hiss and dropouts as age wears it; nature is the speed (1 is 7.5 ips, 2 is 15)"),
P("vinyl",   FAM_SHAPE, 0, 160, 1, "in age", "0 0.4", "out", run_vinyl, 0, mem_vinyl,
  "a record from the archive: crackle and pops, a scratch every turn, rumble, the warp's wow, a worn top end and groove noise; nature is the speed (1 is 33, 1.35 is 45)"),
P("radio",   FAM_SHAPE, 0, 280, 1, "in tune drift", "0 0.5 0.3", "out", run_radio, 0, 0,
  "shortwave at night: a narrow band, fading in and out with a notch wandering through, whistles where carriers beat, static, an AGC that lifts the noise as the station sinks; tune 0.5 is on the station, drift wanders the dial"),
/* ---- the desk ---- */
P("bandsplit", FAM_SHAPE, 0, 240, 1, "in low high", "0 0.3 0.6", "low mid high", run_bandsplit, 0, 0,
  "the sound system's crossover: low, mid and high that sum back flat; low and high are the crossover points, 20 Hz to 20 kHz (after Linkwitz-Riley, fourth order)"),
P("eq",      FAM_SHAPE, 0, 110, 1, "in low mid freq high", "0 0.5 0.5 0.5 0.5", "out", run_eq, 0, 0,
  "the mixer's three knobs: low shelf, sweepable mid (freq 80 Hz to 10 kHz), high shelf; 0.5 is flat, 1 is +12 dB, 0 kills the band (after the DJ mixer's isolator)"),
P("exciter", FAM_SHAPE, 0, 90, 1, "in amount", "0 0.5", "out", run_exciter, 0, 0,
  "the air above it: the top split off, given new harmonics and laid back under the sound, brighter without getting louder (after the Aphex Aural Exciter)"),
/* ---- dynamics ---- */
P("limiter", FAM_SHAPE, 0, 30, 1, "in ceiling release", "0 0.9 0.3", "out reduction", run_limiter, 0, mem_limiter,
  "peak limiter with a block of lookahead: nothing comes out above ceiling, ever; release 5 ms to 1 s, reduction how hard it pulls (0 to 1)"),
P("gate",    FAM_SHAPE, 0, 35, 1, "in threshold", "0 0.05", "out env open", run_gate, 0, 0,
  "noise gate: opens above threshold, closes below half of it, holds 50 ms, then falls; env is how open it is, open pulses each time it opens"),
P("transient", FAM_SHAPE, 0, 120, 1, "in attack sustain", "0 0.5 0.5", "out", run_transient, 0, 0,
  "the hit and the ring: attack above 0.5 sharpens each strike, below softens it; sustain lets the tails bloom or dries them, at any level (after the SPL Transient Designer)"),
/* ---- space and movement ---- */
P("widener", FAM_SPACE, 0, 50, 1, "in right width", "0 0 0.5", "left right", run_widener, 0, mem_widener,
  "mid and side: in is the left (or the only sound), right the right; width 0 mono, 0.5 as it was, 1 sides doubled, the bass kept in the middle; with only in, its own mono-safe stereo (after Lauridsen)"),
P("autopan", FAM_SPACE, 0, 25, 1, "in rate depth", "0 0.3 0.7", "left right", run_autopan, 0, 0,
  "the sound walking between the stacks: mode=lfo|random|follow (a sine, a new place each tick, or quiet left and loud right); rate 0.05 to 25 Hz"),
P("tremolo", FAM_SHAPE, 0, 30, 1, "in rate depth", "0 0.6 0.5", "left right", run_tremolo, 0, 0,
  "tremolo, the amp's bulb blinking: type=amp|harmonic (lows against highs, after the brown Fender amps), shape=0 sine to 1 square, stereo=on throbs the right opposite; rate 0.25 to 30 Hz"),
P("rotary",  FAM_SPACE, 0, 150, 1, "in fast", "0 0", "left right", run_rotary, 0, mem_rotary,
  "the Leslie behind the organ: horn and drum turning at their own speeds, the horn's doppler, both their throb, two microphones; fast above 0.5 spins them up, the heavy drum taking its time (after the Leslie 122)"),
P("autowah", FAM_SHAPE, 0, 110, 1, "in sensitivity resonance", "0 0.5 0.6", "out", run_autowah, 0, 0,
  "envelope filter: play harder and it opens (dir=up) or closes (dir=down), mode=band|low|high (after the Musitronics Mu-Tron III)"),
P("slicer",  FAM_SHAPE, 0, 25, 1, "in clock depth", "0 0 1", "out", run_slicer, 0, 0,
  "trance gate, the dub mixer's mute in time: a step per clock pulse through pattern=trance|eighths|offbeat|onedrop|gallop|tresillo|euclid5|stutter|random, len= of a step open, soft edges; alone at nature x 8 steps a second"),
/* ---- listening ---- */
P("onset",   FAM_CURRENT, 0, 90, 1, "in sensitivity", "0 0.5", "pulse strength env", run_onset, 0, 0,
  "an ear for attacks: each strike in the sound becomes a pulse, over a threshold that rises when it gets busy (spectral flux, lite; like the Wingie's threshold sequencer); strength how hard, env the loudness"),
P("pitchtrack", FAM_CURRENT, 0, 110, 1, "in", "0", "pitch confidence gate", run_pitchtrack, 0, mem_pitchtrack,
  "an ear for pitch: one voice followed, 60 Hz to 1.5 kHz, about 40 times a second; pitch in octaves from nature x 60 Hz (plays any pitch inlet), held when nothing sings; gate while it hears a note (after YIN)"),
/* ---- the rough end ---- */
P("decimate", FAM_SHAPE, 0, 35, 1, "in rate jitter", "0 0.5 0", "out", run_decimate, 0, 0,
  "the sample rate through the floor on a shaky clock: rate 100 Hz to 48 kHz, jitter wobbles each sample's length, hold=step|linear|zero (zero: all mirrors and bells) (after the Disting)"),
P("diode",   FAM_SHAPE, 0, 80, 4, "in carrier leak", "0 0 0.1", "out", run_diode, 0, 0,
  "diode ring modulator: in rides carrier through four diodes with their dead zone and soft knees; leak unbalances the ring so the carrier bleeds through; its own sine at nature x 60 Hz if carrier is empty (after Bode, Parker's model)"),
P("drive",   FAM_SHAPE, 0, 110, 1, "in drive tone", "0 0.5 0.5", "out", run_drive, 0, 0,
  "the pedalboard: type=od|dist|rat|crunch (Tube Screamer, DS-1 into a Big Muff tone stack, ProCo RAT, a valve amp on the edge); tone 0 dark, 1 bright"),
